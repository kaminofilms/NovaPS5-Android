--- /dev/null
+++ b/src/graphics/host_gpu/renderer/pipeline/meshWorkgroup.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+
+namespace Libs::Graphics {
+// The emitter runs both guest wave64 halves on a host subgroup of 32.
+// Leave unsupported cases unchanged so the caller's limit checks reject them.
+constexpr uint32_t SelectMeshSubgroup(uint32_t native_size, uint32_t guest_wave,
+                                      uint32_t guest_threads, uint32_t max_invocations,
+                                      uint32_t max_x, bool can_require_32) {
+    if (guest_wave != 64u || native_size != 64u || !can_require_32) return native_size;
+    const uint64_t waves = (static_cast<uint64_t>(guest_threads) + 63u) / 64u;
+    if ((waves * 64u > max_invocations || waves * 64u > max_x) &&
+        waves * 32u <= max_invocations && waves * 32u <= max_x) return 32u;
+    return native_size;
+}
+} // namespace Libs::Graphics
