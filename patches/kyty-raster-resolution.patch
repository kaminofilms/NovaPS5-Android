+// The guest image remains native-sized. Only raster attachment work uses the
+// proxy; copy/compute/CPU consumers see the restored native image.
+bool Image::CanRasterScale(vk::ImageView view, uint32_t width, uint32_t height) const {
+ if (info.HasStencil() || backing.samples != 1 || backing.extent.width != width || backing.extent.height != height ||
+     backing.extent.depth != 1 || backing.layers != 1 || binding.is_bound) return false;
+ const auto found=std::find_if(views.begin(),views.end(),[&](const auto& v){return v.view==view;});
+ if(found==views.end())return false;
+ const auto& v=found->info;
+ if(v.base_level || v.base_layer || v.layer_count!=1 || v.level_count!=1 ||
+    v.format!=backing.format || v.aspect==vk::ImageAspectFlagBits::eStencil ||
+    (v.aspect & vk::ImageAspectFlagBits::eStencil))return false;
+ const auto features=m_graphics.GetFormatProperties(backing.format).optimalTilingFeatures;
+ return (features & (vk::FormatFeatureFlagBits::eBlitSrc|vk::FormatFeatureFlagBits::eBlitDst)) ==
+                   (vk::FormatFeatureFlagBits::eBlitSrc|vk::FormatFeatureFlagBits::eBlitDst);
+}
