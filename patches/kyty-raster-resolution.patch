+#pragma once
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+#include <cstdint>
+#include <cstdio>
+#include <chrono>
+namespace NovaRaster {
+inline uint32_t Height(){
+ static const auto value=[]()->uint32_t{
+  const auto* title=std::getenv("NOVA_CACHE_TITLE_ID");
+  const auto* request=std::getenv("NOVA_INTERNAL_RESOLUTION");
+  if(!title || std::strcmp(title,"PPSA04703") || !request)return 1080;
+  if(!std::strcmp(request,"720"))return 720;
+  if(!std::strcmp(request,"540"))return 540;
+  if(!std::strcmp(request,"360"))return 360;
+  return 1080;
+ }();return value;
+}
+inline bool Enabled(){return Height()<1080;}
+inline std::pair<uint32_t,uint32_t> Extent(uint32_t w,uint32_t h){
+ const auto target=Height();
+ // The measured main scene. Texture/postprocess/compute and shadow sizes retain
+ // their guest layout, so storage operations and readbacks stay native.
+ if(w==1920 && h==1080 && target<1080)return {target*16/9,target};
+ return {};
+}
+inline void Note(uint32_t w,uint32_t h,uint32_t rw,uint32_t rh){
+ if(!Extent(w,h).first)return;
+ static thread_local uint64_t scaled=0,native=0;
+ static thread_local auto begin=std::chrono::steady_clock::now();
+ rw?++scaled:++native;
+ const auto now=std::chrono::steady_clock::now();
+ if(now-begin>=std::chrono::seconds(5)){
+  std::fprintf(stderr,"NOVA_RESOLUTION_RASTER: native=%ux%u raster=%ux%u scaled_draws=%llu native_fallback_draws=%llu; native-sized compute/readback preserved\n",
+    w,h,Height()*16/9,Height(),(unsigned long long)scaled,(unsigned long long)native);
+  scaled=native=0;begin=now;
+ }
+}
+}
