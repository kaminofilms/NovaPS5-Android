+namespace {
+vk::ImageAspectFlags RasterAspect(const Image& image) {
+ return image.info.IsDepth()?vk::ImageAspectFlagBits::eDepth:vk::ImageAspectFlagBits::eColor;
+}
+void RasterTransition(vk::CommandBuffer command, Image::RasterProxy& proxy,
+                      vk::ImageLayout layout, vk::ImageAspectFlags aspect) {
+ vk::ImageMemoryBarrier2 barrier{};
+ barrier.srcStageMask=proxy.layout==vk::ImageLayout::eUndefined?vk::PipelineStageFlags2{}:vk::PipelineStageFlagBits2::eAllCommands;
+ barrier.srcAccessMask=proxy.layout==vk::ImageLayout::eUndefined?vk::AccessFlags2{}:
+     vk::AccessFlagBits2::eMemoryRead|vk::AccessFlagBits2::eMemoryWrite;
+ barrier.dstStageMask=vk::PipelineStageFlagBits2::eAllCommands;
+ barrier.dstAccessMask=vk::AccessFlagBits2::eMemoryRead|vk::AccessFlagBits2::eMemoryWrite;
+ barrier.oldLayout=proxy.layout;barrier.newLayout=layout;
+ barrier.srcQueueFamilyIndex=barrier.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;
+ barrier.image=proxy.backing.image;barrier.subresourceRange=vk::ImageSubresourceRange{aspect,0,1,0,1};
+ vk::DependencyInfo dependency{};dependency.imageMemoryBarrierCount=1;dependency.pImageMemoryBarriers=&barrier;
+ command.pipelineBarrier2(dependency);proxy.layout=layout;
+}
+void RasterBlit(vk::CommandBuffer command, const VulkanImage& source,const VulkanImage& target,
+                vk::ImageAspectFlags aspect) {
+ vk::ImageBlit blit{};
+ blit.srcSubresource=vk::ImageSubresourceLayers{aspect,0,0,1};blit.dstSubresource=vk::ImageSubresourceLayers{aspect,0,0,1};
+ blit.srcOffsets[1]=vk::Offset3D{int32_t(source.extent.width),int32_t(source.extent.height),1};
+ blit.dstOffsets[1]=vk::Offset3D{int32_t(target.extent.width),int32_t(target.extent.height),1};
+ command.blitImage(source.image,vk::ImageLayout::eTransferSrcOptimal,
+                   target.image,vk::ImageLayout::eTransferDstOptimal,1,&blit,vk::Filter::eNearest);
+}
+}
+
+bool Image::PrepareRasterScale(uint32_t width,uint32_t height) {
+ const auto aspect=RasterAspect(*this);
+ if(!raster_proxy){
+  raster_proxy=std::make_unique<RasterProxy>();
+  auto& proxy=*raster_proxy;
+  vk::ImageCreateInfo create{};create.imageType=vk::ImageType::e2D;
+  create.format=backing.format;create.extent=vk::Extent3D{width,height,1};
+  create.mipLevels=1;create.arrayLayers=1;create.samples=vk::SampleCountFlagBits::e1;
+  create.tiling=vk::ImageTiling::eOptimal;
+  create.usage=vk::ImageUsageFlagBits::eTransferSrc|vk::ImageUsageFlagBits::eTransferDst|
+      (info.IsDepth()?vk::ImageUsageFlagBits::eDepthStencilAttachment:vk::ImageUsageFlagBits::eColorAttachment);
+  if(!m_graphics.CreateImage(create,proxy.backing)){raster_proxy.reset();return false;}
+  vk::ImageViewCreateInfo vi{};vi.image=proxy.backing.image;vi.viewType=vk::ImageViewType::e2D;
+  vi.format=create.format;vi.subresourceRange=vk::ImageSubresourceRange{aspect,0,1,0,1};
+  if(m_graphics.device.createImageView(&vi,nullptr,&proxy.view)!=vk::Result::eSuccess){m_graphics.DeleteImage(proxy.backing);raster_proxy.reset();return false;}
+
+ }
+ return raster_proxy->backing.extent.width==width && raster_proxy->backing.extent.height==height;
+}
+
+vk::ImageView Image::BeginRasterScale(vk::ImageView, uint32_t width,uint32_t height,
+                                     vk::ImageLayout restore,vk::CommandBuffer command) {
+ EXIT_IF(!raster_proxy || raster_proxy->backing.extent.width!=width || raster_proxy->backing.extent.height!=height);
+ const auto aspect=RasterAspect(*this);
+ Transit(vk::ImageLayout::eTransferSrcOptimal,vk::AccessFlagBits2::eTransferRead,{},command);
+ RasterTransition(command,*raster_proxy,vk::ImageLayout::eTransferDstOptimal,aspect);
+ RasterBlit(command,backing,raster_proxy->backing,aspect);
+ Transit(restore,binding.attachment_access,{},command);
+ RasterTransition(command,*raster_proxy,restore,aspect);
+ return raster_proxy->view;
+}
+void Image::EndRasterScale(vk::ImageView, vk::ImageLayout restore,vk::CommandBuffer command) {
+ EXIT_IF(!raster_proxy);
+ const auto aspect=RasterAspect(*this);
+ RasterTransition(command,*raster_proxy,vk::ImageLayout::eTransferSrcOptimal,aspect);
+ Transit(vk::ImageLayout::eTransferDstOptimal,vk::AccessFlagBits2::eTransferWrite,{},command);
+ RasterBlit(command,raster_proxy->backing,backing,aspect);
+ Transit(restore,binding.attachment_access,{},command);
+}
