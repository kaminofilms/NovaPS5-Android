new file mode 100644
index 0000000..69812e9
--- /dev/null
+++ b/src/common/novaFex.h
@@ -0,0 +1,82 @@
+#ifndef KYTY_COMMON_NOVA_FEX_H_
+#define KYTY_COMMON_NOVA_FEX_H_
+
+// Nova PS5 native AArch64 host: guest (PS5 x86-64) code runs in an embedded FEXCore,
+// the emulator itself is native. See NovaPS5-Android native/novafex/novafex.h.
+#if defined(__aarch64__)
+#define KYTY_NOVA_FEX 1
+#include <novafex.h>
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+// Guest addresses above 2^39 (PS5 libc/Unreal arenas) live in 1 GiB slots backed by separate
+// host windows. Host code (syscalls, memcpy) must translate them piece by piece: a syscall
+// given an untranslated high pointer fails with EFAULT instead of faulting, and per-access
+// fault emulation is far too slow for bulk copies.
+namespace NovaGuest {
+constexpr uint64_t kLow  = uint64_t {1} << 39;
+constexpr uint64_t kSlot = uint64_t {1} << 30;
+inline bool        IsHigh(uint64_t a, uint64_t n) { return a >= kLow || n > kLow - a; }
+inline bool        IsHigh(const void* a, uint64_t n) { return IsHigh(reinterpret_cast<uint64_t>(a), n); }
+// Longest run starting at a that stays inside one translation unit.
+inline uint64_t Piece(uint64_t a, uint64_t n) {
+	const uint64_t limit = a < kLow ? kLow - a : ((a | (kSlot - 1)) + 1) - a;
+	return std::min(n, limit);
+}
+inline void* Host(uint64_t a) { return reinterpret_cast<void*>(static_cast<uintptr_t>(NovaFex::TranslateGuestVA(a))); }
+inline void  Copy(void* dst, const void* src, uint64_t n) {
+	auto d = reinterpret_cast<uint64_t>(dst);
+	auto s = reinterpret_cast<uint64_t>(src);
+	if (!IsHigh(d, n) && !IsHigh(s, n)) {
+		std::memcpy(dst, src, n);
+		return;
+	}
+	while (n != 0) {
+		const uint64_t c = Piece(s, Piece(d, n));
+		std::memcpy(Host(d), Host(s), c);
+		d += c;
+		s += c;
+		n -= c;
+	}
+}
+inline void Set(void* dst, int v, uint64_t n) {
+	auto d = reinterpret_cast<uint64_t>(dst);
+	if (!IsHigh(d, n)) {
+		std::memset(dst, v, n);
+		return;
+	}
+	while (n != 0) {
+		const uint64_t c = Piece(d, n);
+		std::memset(Host(d), v, c);
+		d += c;
+		n -= c;
+	}
+}
+inline int Compare(const void* a, const void* b, uint64_t n) {
+	auto x = reinterpret_cast<uint64_t>(a);
+	auto y = reinterpret_cast<uint64_t>(b);
+	if (!IsHigh(x, n) && !IsHigh(y, n)) return std::memcmp(a, b, n);
+	while (n != 0) {
+		const uint64_t c = Piece(y, Piece(x, n));
+		if (const int r = std::memcmp(Host(x), Host(y), c); r != 0) return r;
+		x += c;
+		y += c;
+		n -= c;
+	}
+	return 0;
+}
+// Calls fn(host_pointer, length) for each piece; stops when fn returns false.
+template <typename F>
+inline void ForEach(uint64_t a, uint64_t n, F&& fn) {
+	while (n != 0) {
+		const uint64_t c = Piece(a, n);
+		if (!fn(Host(a), c)) return;
+		a += c;
+		n -= c;
+	}
+}
+} // namespace NovaGuest
+#endif
+
+#endif /* KYTY_COMMON_NOVA_FEX_H_ */
