+#if defined(__aarch64__)
+// Native AArch64 host (NovaFex). Faults raised by translated guest code arrive here with the
+// JIT's host context; access type comes from the ESR record of the signal frame.
+static uint64_t ReadEsr(const ucontext_t* context) {
+	const auto* p   = reinterpret_cast<const uint8_t*>(context->uc_mcontext.__reserved);
+	const auto* end = p + sizeof(context->uc_mcontext.__reserved);
+	while (p + 8 <= end) {
+		uint32_t magic = 0;
+		uint32_t size  = 0;
+		std::memcpy(&magic, p, 4);
+		std::memcpy(&size, p + 4, 4);
+		if (magic == 0 || size == 0) {
+			break;
+		}
+		if (magic == 0x45535201u && size >= 16) { // ESR_MAGIC
+			uint64_t esr = 0;
+			std::memcpy(&esr, p + 8, 8);
+			return esr;
+		}
+		p += size;
+	}
+	return 0;
+}
+
+// A fault the handler reports as handled but that recurs immediately at the same instruction and
+// address never makes progress: the thread spins in the handler and the game freezes without a
+// message. Hundreds of identical faults within a fraction of a second are that loop. A page fault
+// is broken by making the page accessible (the GPU cache may then miss one CPU write, which is far
+// better than a frozen game); anything else is reported and ends the process.
+// Returns true when the fault cannot be broken and the default action should follow.
+static bool IsGuestReadable(uint64_t address) {
+	return address >= 0x10000;
+}
+
+static bool FaultLoops(int signal_number, const ucontext_t* context, const ExceptionInfo& info) {
+	struct Repeat {
+		uint64_t pc;
+		uint64_t address;
+		uint64_t since_ns;
+		uint32_t count;
+	};
+	static thread_local Repeat repeat {};
+	static std::atomic<uint32_t> broken {0};
+	timespec now {};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	const uint64_t now_ns = static_cast<uint64_t>(now.tv_sec) * 1000000000ull + static_cast<uint64_t>(now.tv_nsec);
+	if (repeat.pc != info.exception_address || repeat.address != info.access_violation_vaddr ||
+	    now_ns - repeat.since_ns > 250000000ull) {
+		repeat = {info.exception_address, info.access_violation_vaddr, now_ns, 1};
+		return false;
+	}
+	if (++repeat.count < 512) {
+		return false;
+	}
+	repeat.count = 0;
+	const auto     esr         = ReadEsr(context);
+	const uint32_t instruction = IsGuestReadable(info.exception_address) ? *reinterpret_cast<const uint32_t*>(info.exception_address) : 0;
+	std::fprintf(stderr,
+	             "NOVA_FAULT_LOOP: signal=%d pc=0x%016llx address=0x%016llx esr=0x%llx insn=0x%08x access=%u\n",
+	             signal_number, static_cast<unsigned long long>(info.exception_address),
+	             static_cast<unsigned long long>(info.access_violation_vaddr), static_cast<unsigned long long>(esr),
+	             instruction, static_cast<unsigned>(info.access_violation_type));
+	if (signal_number != SIGSEGV) {
+		return true;
+	}
+	const auto page = static_cast<uint64_t>(sysconf(_SC_PAGESIZE));
+	const auto base = info.access_violation_vaddr & ~(page - 1);
+	if (mprotect(reinterpret_cast<void*>(base), page, PROT_READ | PROT_WRITE) != 0) {
+		return true;
+	}
+	if (broken.fetch_add(1, std::memory_order_relaxed) < 32) {
+		std::fprintf(stderr, "NOVA_FAULT_LOOP: page 0x%016llx made writable to continue\n",
+		             static_cast<unsigned long long>(base));
+	}
+	return false;
+}
+
+static void SignalHandler(int signal_number, siginfo_t* signal_info, void* native_context) {
+	auto* context = static_cast<ucontext_t*>(native_context);
+	if (NovaFex::HandleHostFault(signal_number, signal_info, native_context)) {
+		return;
+	}
+
+	ExceptionInfo info {};
+	info.exception_address = context->uc_mcontext.pc;
+	info.native_code       = static_cast<uint32_t>(signal_number);
+	info.native_context    = context;
+
+	if (signal_number == SIGSEGV || signal_number == SIGBUS) {
+		info.type      = ExceptionType::AccessViolation;
+		const auto esr = ReadEsr(context);
+		const auto ec  = (esr >> 26u) & 0x3fu;
+		if (ec == 0x20 || ec == 0x21 || reinterpret_cast<uint64_t>(signal_info->si_addr) == info.exception_address) {
+			info.access_violation_type = AccessViolationType::Execute;
+		} else if ((esr & (1u << 6u)) != 0) { // WnR
+			info.access_violation_type = AccessViolationType::Write;
+		} else {
+			info.access_violation_type = AccessViolationType::Read;
+		}
+		info.access_violation_vaddr = reinterpret_cast<uint64_t>(signal_info->si_addr);
+	} else if (signal_number == SIGILL) {
+		info.type = ExceptionType::IllegalInstruction;
+	} else {
+		ChainToDefault(signal_number);
+		return;
+	}
+
+	// Host registers for the fault report (x0..x15 in the rax..r15 slots).
+	const auto* x = context->uc_mcontext.regs;
+	info.rax = x[0];
+	info.rbx = x[1];
+	info.rcx = x[2];
+	info.rdx = x[3];
+	info.rsi = x[4];
+	info.rdi = x[5];
+	info.rbp = x[29];
+	info.rsp = context->uc_mcontext.sp;
+	info.r8  = x[8];
+	info.r9  = x[9];
+	info.r10 = x[10];
+	info.r11 = x[11];
+	info.r12 = x[12];
+	info.r13 = x[13];
+	info.r14 = x[14];
+	info.r15 = x[30];
+
+	const auto handler = g_handler.load(std::memory_order_acquire);
+	if (handler != nullptr && handler(info)) {
+		if (info.type == ExceptionType::AccessViolation && FaultLoops(signal_number, context, info)) {
+			ChainToDefault(signal_number);
+		}
+		return;
+	}
+
+	ChainToDefault(signal_number);
+}
+#else
 static void SignalHandler(int signal_number, siginfo_t* signal_info, void* native_context) {
