+static void PrintHostBacktrace() {
+#if defined(__linux__)
+	void*     frames[48];
+	const int count = backtrace(frames, 48);
+	std::fprintf(stderr, "--- Host backtrace ---\n");
+	for (int i = 1; i < count; i++) {
+		Dl_info info {};
+		const auto address = reinterpret_cast<uintptr_t>(frames[i]);
+		if (dladdr(frames[i], &info) != 0 && info.dli_fname != nullptr) {
+			int   status    = 0;
+			char* demangled = info.dli_sname != nullptr
+			                      ? abi::__cxa_demangle(info.dli_sname, nullptr, nullptr, &status)
+			                      : nullptr;
+			const char* name = demangled != nullptr ? demangled : (info.dli_sname != nullptr ? info.dli_sname : "?");
+			std::fprintf(stderr, "#%02d %s+0x%zx %.200s\n", i, info.dli_fname,
+			             static_cast<size_t>(address - reinterpret_cast<uintptr_t>(info.dli_fbase)), name);
+			std::free(demangled);
+		} else {
+			std::fprintf(stderr, "#%02d 0x%zx\n", i, static_cast<size_t>(address));
+		}
+	}
+	std::fflush(stderr);
+#endif
+}
