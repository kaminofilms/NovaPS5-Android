+const SymbolRecord* SymbolDatabase::FindNearestBelow(uint64_t vaddr) const {
+	const SymbolRecord* best = nullptr;
+	for (const auto& symbol: m_symbols) {
+		if (symbol.vaddr != 0 && symbol.vaddr <= vaddr && (best == nullptr || symbol.vaddr > best->vaddr)) {
+			best = &symbol;
+		}
+	}
+	return best;
+}
+
+uint64_t SymbolDatabase::NextVaddrAfter(uint64_t vaddr) const {
+	uint64_t next = 0;
+	for (const auto& symbol: m_symbols) {
+		if (symbol.vaddr > vaddr && (next == 0 || symbol.vaddr < next)) {
+			next = symbol.vaddr;
+		}
+	}
+	return next;
+}
