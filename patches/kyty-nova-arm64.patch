+void PrepareLibc() {
+	if (!g_registered) return;
+	std::lock_guard lock(g_mutex);
+	if (!Init()) {
+		std::fprintf(stderr, "NOVA_HEAP: pre-entry allocator preparation failed\n");
+		return;
+	}
+	if (!g_patched) {
+		PatchLibc();
+		g_patched = true;
+	}
