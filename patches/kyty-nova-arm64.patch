+// Address the guest sees for an HLE export: functions are native AArch64 code on the Nova
+// host and are reached through a NovaFex gate; data objects are shared directly.
+inline uint64_t NovaExportAddress(uint64_t address, Loader::SymbolType type) {
+#if defined(KYTY_NOVA_FEX)
+	if (type == Loader::SymbolType::Func && address != 0) {
+		return NovaFex::MakeGate(reinterpret_cast<const void*>(address));
+	}
+#endif
+	(void)type;
+	return address;
+}
+// Lets crash reports name HLE functions that have no dynamic symbol.
+inline void NovaNameHost(uint64_t address, const char* name) {
+#if defined(KYTY_NOVA_FEX)
+	NovaFex::NameHostFunction(reinterpret_cast<const void*>(address), name);
+#else
+	(void)address;
+	(void)name;
+#endif
+}
+} // namespace Libs
+
 namespace Libs {
 
