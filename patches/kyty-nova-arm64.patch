new file mode 100644
index 0000000..0c000f2
--- /dev/null
+++ b/src/common/guestMemory.h
@@ -0,0 +1,91 @@
+#ifndef KYTY_COMMON_GUEST_MEMORY_H_
+#define KYTY_COMMON_GUEST_MEMORY_H_
+
+// Host (emulator) access to guest memory by guest address.
+//
+// On the 39-bit Nova Android host, guest addresses at or above 2^39 are translated per 1 GiB slot
+// (common/novaFex.h). Host code that dereferences such an address directly faults, and NovaFex
+// emulates the faulting load/store one instruction at a time: correct, but thousands of times
+// slower than a plain access. The GPU front end (command buffers, shader code, buffer uploads,
+// index and indirect reads) must therefore translate before touching guest memory. Everywhere
+// else these helpers are the identity.
+
+#include "common/novaFex.h"
+
+#include <cstdint>
+#include <cstring>
+
+namespace GuestMemory {
+
+// Host pointer for the guest range [address, address + size) when the range is contiguous on the
+// host (one translation unit). Otherwise the guest address itself: accesses then still work
+// through fault emulation, only slowly.
+template <typename T = void>
+inline T* Ptr(uint64_t address, uint64_t size = 1) noexcept {
+#if defined(KYTY_NOVA_FEX)
+	if (address != 0 && size != 0 && NovaGuest::IsHigh(address, size) &&
+	    NovaGuest::Piece(address, size) == size) {
+		return reinterpret_cast<T*>(static_cast<uintptr_t>(NovaFex::TranslateGuestVA(address)));
+	}
+#endif
+	(void)size;
+	return reinterpret_cast<T*>(static_cast<uintptr_t>(address));
+}
+
+template <typename T>
+inline T* Ptr(T* address, uint64_t size) noexcept {
+	return Ptr<T>(reinterpret_cast<uint64_t>(address), size);
+}
+
+// Copies between any combination of guest and host buffers; ranges may span translation units.
+inline void Copy(void* dst, const void* src, uint64_t size) noexcept {
+#if defined(KYTY_NOVA_FEX)
+	NovaGuest::Copy(dst, src, size);
+#else
+	std::memcpy(dst, src, size);
+#endif
+}
+
+inline void Read(void* dst, uint64_t guest_src, uint64_t size) noexcept {
+	Copy(dst, reinterpret_cast<const void*>(static_cast<uintptr_t>(guest_src)), size);
+}
+
+inline void Write(uint64_t guest_dst, const void* src, uint64_t size) noexcept {
+	Copy(reinterpret_cast<void*>(static_cast<uintptr_t>(guest_dst)), src, size);
+}
+
+// memset for guest memory; the range may span translation units.
+inline void Set(uint64_t guest_dst, int value, uint64_t size) noexcept {
+#if defined(KYTY_NOVA_FEX)
+	NovaGuest::Set(reinterpret_cast<void*>(static_cast<uintptr_t>(guest_dst)), value, size);
+#else
+	std::memset(reinterpret_cast<void*>(static_cast<uintptr_t>(guest_dst)), value, size);
+#endif
+}
+
+// Fills dwords; the range may span translation units.
+inline void Fill32(uint64_t guest_dst, uint32_t value, uint64_t size) noexcept {
+	while (size >= sizeof(uint32_t)) {
+#if defined(KYTY_NOVA_FEX)
+		const uint64_t piece = NovaGuest::Piece(guest_dst, size) & ~uint64_t {3};
+#else
+		const uint64_t piece = size & ~uint64_t {3};
+#endif
+		if (piece == 0) {
+			Write(guest_dst, &value, sizeof(value));
+			guest_dst += sizeof(value);
+			size -= sizeof(value);
+			continue;
+		}
+		auto* p = Ptr<uint32_t>(guest_dst, piece);
+		for (uint64_t i = 0; i < piece / sizeof(uint32_t); i++) {
+			p[i] = value;
+		}
+		guest_dst += piece;
+		size -= piece;
+	}
+}
+
+} // namespace GuestMemory
+
+#endif /* KYTY_COMMON_GUEST_MEMORY_H_ */
