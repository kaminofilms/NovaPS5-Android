+#include <stddef.h>
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+/* tlsf_t: a TLSF structure. Can contain 1 to N pools. */
+/* pool_t: a block of memory that TLSF can manage. */
+typedef void* tlsf_t;
+typedef void* pool_t;
+
+/* Create/destroy a memory pool. */
+tlsf_t tlsf_create(void* mem);
+tlsf_t tlsf_create_with_pool(void* mem, size_t bytes);
+void tlsf_destroy(tlsf_t tlsf);
+pool_t tlsf_get_pool(tlsf_t tlsf);
+
+/* Add/remove memory pools. */
+pool_t tlsf_add_pool(tlsf_t tlsf, void* mem, size_t bytes);
+void tlsf_remove_pool(tlsf_t tlsf, pool_t pool);
+
+/* malloc/memalign/realloc/free replacements. */
+void* tlsf_malloc(tlsf_t tlsf, size_t bytes);
+void* tlsf_memalign(tlsf_t tlsf, size_t align, size_t bytes);
+void* tlsf_realloc(tlsf_t tlsf, void* ptr, size_t size);
+void tlsf_free(tlsf_t tlsf, void* ptr);
+
+/* Returns internal block size, not original request size */
+size_t tlsf_block_size(void* ptr);
+
+/* Overheads/limits of internal structures. */
+size_t tlsf_size(void);
+size_t tlsf_align_size(void);
+size_t tlsf_block_size_min(void);
+size_t tlsf_block_size_max(void);
+size_t tlsf_pool_overhead(void);
+size_t tlsf_alloc_overhead(void);
+
+/* Debugging. */
+typedef void (*tlsf_walker)(void* ptr, size_t size, int used, void* user);
+void tlsf_walk_pool(pool_t pool, tlsf_walker walker, void* user);
+/* Returns nonzero if any internal consistency check fails. */
+int tlsf_check(tlsf_t tlsf);
+int tlsf_check_pool(pool_t pool);
+
+#if defined(__cplusplus)
+};
+#endif
+
+#endif
diff --git a/src/libs/novaHeap.cpp b/src/libs/novaHeap.cpp
new file mode 100644
index 0000000..c8629e7
--- /dev/null
+++ b/src/libs/novaHeap.cpp
@@ -0,0 +1,683 @@
+// Nova: an emulator-side libc heap (malloc family and C++ operator new/delete).
+//
+// Why: Sony's libc reserves the whole heap arena up front. Unreal Engine titles ask it for a
+// 512 GiB arena and place large allocations at its top end. Android gives an app a 39-bit
+// (512 GiB) address space in total, so that top end can never be mapped and the title's libc
+// heap fails (Luna Abyss: MapDirect at base + 511 GiB -> ENOMEM -> null dereference).
+// When the launcher enables it (NOVA_HEAP_HLE=1, set for Unreal titles), the game's allocation
+// imports are bound here instead. Memory comes from direct memory mapped inside one 32 GiB
+// reservation, exactly how the PS5 libc heap backs itself, so the GPU can use it as well.
+// Pointers that libc.prx handed out itself (strdup, getline, ...) are recognised by address and
+// passed back to libc.prx. AnyPS5 implements its libc heap the same way (emulator-side heap,
+// github.com/boykopovar/AnyPS5 core/libs/prx/libc/src/GuestHeap.cpp, GPL-2.0).
+
+#include "common/logging/log.h"
+#include "common/novaFex.h"
+#include "kernel/memory.h"
+#include "libs/libs.h"
+#include "libs/nova/tlsf.h"
+#include "loader/symbolDatabase.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <sys/mman.h>
+
+namespace Loader {
+uint64_t NovaFindModuleExport(const char* nid);
+uint64_t NovaNextModuleExport(uint64_t vaddr);
+} // namespace Loader
+
+namespace Libs::NovaHeap {
+
+namespace {
+
+constexpr uint64_t kReserve      = 32ull << 30; // whole heap address range
+constexpr uint64_t kSmallRange   = 16ull << 30; // TLSF pools live in the lower half
+constexpr uint64_t kChunk        = 256ull << 20; // TLSF pool growth step
+constexpr uint64_t kLargeMin     = 32ull << 20;  // >= this: its own mapping in the upper half
+constexpr uint64_t kGranule      = 2ull << 20;
+constexpr int      kProt         = 0x33; // CPU RW + GPU RW
+constexpr int      kFixed        = 0x10;
+
+struct Large {
+	uint64_t size;
+	int64_t  phys;
+};
+
+std::recursive_mutex                g_mutex;
+uint64_t                            g_base       = 0;
+uint64_t                            g_small_used = 0;
+uint64_t                            g_large_next = 0;
+tlsf_t                              g_tlsf       = nullptr;
+std::map<uint64_t, Large>           g_large;
+std::vector<std::pair<uint64_t, uint64_t>> g_large_free; // reusable address ranges
+uint64_t                            g_libc_free = 0, g_libc_realloc = 0, g_libc_usable = 0;
+bool                                g_failed    = false;
+bool                                g_patched   = false;
+
+uint64_t AlignUp(uint64_t v, uint64_t a) {
+	return (v + a - 1) & ~(a - 1);
+}
+
+bool MapAt(uint64_t addr, uint64_t size, int64_t* phys_out) {
+	int64_t phys = 0;
+	if (LibKernel::Memory::KernelAllocateMainDirectMemory(size, kGranule, 0, &phys) != 0) {
+		std::fprintf(stderr, "NOVA_HEAP: out of direct memory (wanted 0x%llx)\n", static_cast<unsigned long long>(size));
+		return false;
+	}
+	void* where = reinterpret_cast<void*>(addr);
+	if (LibKernel::Memory::KernelMapNamedDirectMemory(&where, size, kProt, kFixed, phys, kGranule, "nova_heap") != 0) {
+		LibKernel::Memory::KernelReleaseDirectMemory(phys, size);
+		std::fprintf(stderr, "NOVA_HEAP: map failed at 0x%llx size 0x%llx\n", static_cast<unsigned long long>(addr),
+		             static_cast<unsigned long long>(size));
+		return false;
+	}
+	*phys_out = phys;
+	return true;
+}
+
+void PatchLibc();
+
+bool Init() {
+	if (g_base != 0) return true;
+	if (g_failed) return false;
+	void* base = nullptr;
+	if (LibKernel::Memory::KernelReserveVirtualRange(&base, kReserve, 0, kGranule) != 0 || base == nullptr) {
+		std::fprintf(stderr, "NOVA_HEAP: could not reserve the heap range\n");
+		g_failed = true;
+		return false;
+	}
+	g_base       = reinterpret_cast<uint64_t>(base);
+	g_large_next = g_base + kSmallRange;
+	g_libc_free    = Loader::NovaFindModuleExport("tIhsqj0qsFE");
+	g_libc_realloc = Loader::NovaFindModuleExport("Y7aJ1uydPMo");
+	g_libc_usable  = Loader::NovaFindModuleExport("NDcSfcYZRC8");
+	std::fprintf(stderr, "NOVA_HEAP: emulator heap at 0x%llx (libc.prx free=0x%llx realloc=0x%llx)\n",
+	             static_cast<unsigned long long>(g_base), static_cast<unsigned long long>(g_libc_free),
+	             static_cast<unsigned long long>(g_libc_realloc));
+	return true;
+}
+
+bool GrowSmall(uint64_t at_least) {
+	const uint64_t size = AlignUp(std::max(kChunk, at_least + (1u << 20)), kGranule);
+	if (g_small_used + size > kSmallRange) return false;
+	int64_t phys = 0;
+	const uint64_t addr = g_base + g_small_used;
+	if (!MapAt(addr, size, &phys)) return false;
+	g_small_used += size;
+	if (g_tlsf == nullptr) {
+		g_tlsf = tlsf_create_with_pool(reinterpret_cast<void*>(addr), size);
+	} else {
+		tlsf_add_pool(g_tlsf, reinterpret_cast<void*>(addr), size);
+	}
+	return g_tlsf != nullptr;
+}
+
+void* AllocLarge(uint64_t bytes, uint64_t align) {
+	if (align > kGranule) return nullptr;
+	const uint64_t size = AlignUp(bytes, kGranule);
+	uint64_t       addr = 0;
+	for (auto it = g_large_free.begin(); it != g_large_free.end(); ++it) {
+		if (it->second >= size) {
+			addr = it->first;
+			if (it->second == size) {
+				g_large_free.erase(it);
+			} else {
+				it->first += size;
+				it->second -= size;
+			}
+			break;
+		}
+	}
+	if (addr == 0) {
+		if (g_large_next + size > g_base + kReserve) return nullptr;
+		addr = g_large_next;
+		g_large_next += size;
+	}
+	int64_t phys = 0;
+	if (!MapAt(addr, size, &phys)) {
+		g_large_free.emplace_back(addr, size);
+		return nullptr;
+	}
+	g_large[addr] = {size, phys};
+	return reinterpret_cast<void*>(addr);
+}
+
+void* Alloc(uint64_t bytes, uint64_t align) {
+	std::lock_guard lock(g_mutex);
+	if (!Init()) return nullptr;
+	if (bytes == 0) bytes = 1;
+	if (align < 16) align = 16;
+	if (bytes >= kLargeMin) {
+		void* p = AllocLarge(bytes, align);
+		static int logged = 0;
+		if (logged++ < 32) {
+			std::fprintf(stderr, "NOVA_HEAP: large allocation 0x%llx -> %p\n", static_cast<unsigned long long>(bytes), p);
+		}
+		return p;
+	}
+	for (int attempt = 0; attempt < 2; attempt++) {
+		if (g_tlsf != nullptr) {
+			void* p = align <= 16 ? tlsf_malloc(g_tlsf, bytes) : tlsf_memalign(g_tlsf, align, bytes);
+			if (p != nullptr) return p;
+		}
+		if (!GrowSmall(bytes + align)) break;
+	}
+	std::fprintf(stderr, "NOVA_HEAP: allocation of 0x%llx failed\n", static_cast<unsigned long long>(bytes));
+	return nullptr;
+}
+
+bool Ours(const void* p) {
+	const auto a = reinterpret_cast<uint64_t>(p);
+	return g_base != 0 && a >= g_base && a < g_base + kReserve;
+}
+
+uint64_t Usable(void* p) {
+	const auto a = reinterpret_cast<uint64_t>(p);
+	if (a >= g_base + kSmallRange) {
+		auto it = g_large.find(a);
+		return it != g_large.end() ? it->second.size : 0;
+	}
+	return tlsf_block_size(p);
+}
+
+void Free(void* p) {
+	if (p == nullptr) return;
+	if (!Ours(p)) {
+		if (g_libc_free != 0) NovaFex::CallGuest(g_libc_free, reinterpret_cast<uint64_t>(p));
+		return;
+	}
+	std::lock_guard lock(g_mutex);
+	const auto a = reinterpret_cast<uint64_t>(p);
+	if (a >= g_base + kSmallRange) {
+		auto it = g_large.find(a);
+		if (it == g_large.end()) return;
+		LibKernel::Memory::KernelMunmap(a, it->second.size);
+		LibKernel::Memory::KernelReleaseDirectMemory(it->second.phys, it->second.size);
+		g_large_free.emplace_back(a, it->second.size);
+		g_large.erase(it);
+		return;
+	}
+	tlsf_free(g_tlsf, p);
+}
+
+uint64_t ForeignUsable(void* p) {
+	return g_libc_usable != 0 ? NovaFex::CallGuest(g_libc_usable, reinterpret_cast<uint64_t>(p)) : 0;
+}
+
+void* Realloc(void* p, uint64_t bytes, uint64_t align) {
+	if (p == nullptr) return Alloc(bytes, align);
+	if (bytes == 0) {
+		Free(p);
+		return nullptr;
+	}
+	uint64_t old = 0;
+	if (Ours(p)) {
+		std::lock_guard lock(g_mutex);
+		old = Usable(p);
+		if (old >= bytes && (reinterpret_cast<uint64_t>(p) & (std::max<uint64_t>(align, 16) - 1)) == 0) return p;
+		if (old < kLargeMin && bytes < kLargeMin && align <= 16) {
+			if (void* q = tlsf_realloc(g_tlsf, p, bytes); q != nullptr) return q;
+		}
+	} else {
+		old = ForeignUsable(p);
+	}
+	void* q = Alloc(bytes, align);
+	if (q == nullptr) return nullptr;
+	if (old != 0) std::memcpy(q, p, std::min(old, bytes));
+	Free(p);
+	return q;
+}
+
+// --- guest-facing entry points (SysV ABI) ---
+
+KYTY_SYSV_ABI void* nova_malloc(size_t n) {
+	return Alloc(n, 16);
+}
+KYTY_SYSV_ABI void nova_free(void* p) {
+	Free(p);
+}
+KYTY_SYSV_ABI void* nova_calloc(size_t n, size_t m) {
+	if (m != 0 && n > SIZE_MAX / m) return nullptr;
+	void* p = Alloc(n * m, 16);
+	if (p != nullptr) std::memset(p, 0, n * m);
+	return p;
+}
+KYTY_SYSV_ABI void* nova_realloc(void* p, size_t n) {
+	return Realloc(p, n, 16);
+}
+KYTY_SYSV_ABI void* nova_memalign(size_t align, size_t n) {
+	return Alloc(n, align);
+}
+KYTY_SYSV_ABI void* nova_aligned_alloc(size_t align, size_t n) {
+	return Alloc(n, align);
+}
+KYTY_SYSV_ABI int nova_posix_memalign(void** out, size_t align, size_t n) {
+	if (out == nullptr || align < sizeof(void*) || (align & (align - 1)) != 0) return 22; // EINVAL
+	void* p = Alloc(n, align);
+	if (p == nullptr) return 12; // ENOMEM
+	*out = p;
+	return 0;
+}
+KYTY_SYSV_ABI void* nova_reallocalign(void* p, size_t n, size_t align) {
+	return Realloc(p, n, align);
+}
+KYTY_SYSV_ABI size_t nova_malloc_usable_size(void* p) {
+	if (p == nullptr) return 0;
+	if (!Ours(p)) return ForeignUsable(p);
+	std::lock_guard lock(g_mutex);
+	return Usable(p);
+}
+KYTY_SYSV_ABI void* nova_new(size_t n) {
+	void* p = Alloc(n, 16);
+	if (p == nullptr) {
+		std::fprintf(stderr, "NOVA_HEAP: operator new(0x%llx) failed\n", static_cast<unsigned long long>(n));
+		std::abort();
+	}
+	return p;
+}
+KYTY_SYSV_ABI void* nova_new_nothrow(size_t n, const void* /*nothrow*/) {
+	return Alloc(n, 16);
+}
+KYTY_SYSV_ABI void* nova_new_aligned(size_t n, size_t align) {
+	void* p = Alloc(n, align);
+	if (p == nullptr) {
+		std::fprintf(stderr, "NOVA_HEAP: aligned operator new(0x%llx) failed\n", static_cast<unsigned long long>(n));
+		std::abort();
+	}
+	return p;
+}
+KYTY_SYSV_ABI void* nova_new_aligned_nothrow(size_t n, size_t align, const void* /*nothrow*/) {
+	return Alloc(n, align);
+}
+KYTY_SYSV_ABI void nova_delete(void* p) {
+	Free(p);
+}
+KYTY_SYSV_ABI void nova_delete_2(void* p, size_t /*size_or_align_or_nothrow*/) {
+	Free(p);
+}
+KYTY_SYSV_ABI void nova_delete_3(void* p, size_t /*size*/, size_t /*align*/) {
+	Free(p);
+}
+
+// Send libc.prx's own allocator entry points to the emulator heap too, so allocations libc makes
+// for itself or for callers that reach it without an import (the Unreal crash path) also land in
+// the emulator heap. An export is rewritten to `jmp [rip+0]; .quad gate` (14 bytes) only when the
+// next export starts at least 14 bytes later. free/realloc/malloc_usable_size are rewritten only
+// when the export is a jump thunk, whose real target then serves pointers libc handed out itself.
+uint64_t ThunkTarget(uint64_t addr) {
+	const auto* b = reinterpret_cast<const uint8_t*>(addr);
+	if (b[0] == 0xE9) {
+		int32_t rel = 0;
+		std::memcpy(&rel, b + 1, 4);
+		return addr + 5 + static_cast<int64_t>(rel);
+	}
+	if (b[0] == 0xFF && b[1] == 0x25) {
+		int32_t rel = 0;
+		std::memcpy(&rel, b + 2, 4);
+		uint64_t target = 0;
+		std::memcpy(&target, reinterpret_cast<const void*>(addr + 6 + static_cast<int64_t>(rel)), 8);
+		return target;
+	}
+	return 0;
+}
+
+// Length of a ModRM operand (ModRM byte, SIB, displacement) at p, or 0 for RIP-relative.
+int ModRmLen(const uint8_t* p) {
+	const uint8_t modrm = p[0];
+	const int mod = modrm >> 6;
+	const int rm  = modrm & 7;
+	if (mod == 3) return 1;
+	int len = 1;
+	if (rm == 4) {
+		const uint8_t sib = p[1];
+		len++;
+		if (mod == 0 && (sib & 7) == 5) len += 4;
+	} else if (mod == 0 && rm == 5) {
+		return 0; // RIP-relative: not relocatable here
+	}
+	if (mod == 1) len += 1;
+	if (mod == 2) len += 4;
+	return len;
+}
+
+// Copies one instruction from src (guest address pc) to out, relocating relative branches.
+// Returns the source length, 0 if the instruction is not supported.
+int RelocateInsn(const uint8_t* src, uint64_t pc, std::vector<uint8_t>* out) {
+	const uint8_t* p = src;
+	if (p[0] == 0xF3 && p[1] == 0x0F && p[2] == 0x1E && p[3] == 0xFA) { // endbr64
+		out->insert(out->end(), p, p + 4);
+		return 4;
+	}
+	auto abs_jmp = [&](uint64_t target) {
+		const uint8_t j[6] = {0xFF, 0x25, 0, 0, 0, 0};
+		out->insert(out->end(), j, j + 6);
+		for (int i = 0; i < 8; i++) out->push_back(static_cast<uint8_t>(target >> (8 * i)));
+	};
+	// Relative branches.
+	if ((p[0] & 0xF0) == 0x70 || p[0] == 0xEB) {
+		const uint64_t target = pc + 2 + static_cast<int8_t>(p[1]);
+		if (p[0] == 0xEB) {
+			abs_jmp(target);
+		} else {
+			out->push_back(static_cast<uint8_t>(p[0] ^ 1)); // inverted condition skips the jump
+			out->push_back(14);
+			abs_jmp(target);
+		}
+		return 2;
+	}
+	if (p[0] == 0x0F && (p[1] & 0xF0) == 0x80) {
+		int32_t rel = 0;
+		std::memcpy(&rel, p + 2, 4);
+		out->push_back(static_cast<uint8_t>(0x70 | ((p[1] & 0x0F) ^ 1)));
+		out->push_back(14);
+		abs_jmp(pc + 6 + static_cast<int64_t>(rel));
+		return 6;
+	}
+	// Snapshot the original dispatch target. The live slot may subsequently be redirected to
+	// NovaHeap; a foreign-pointer trampoline must keep calling libc's original allocator.
+	if (p[0] == 0xFF && (p[1] == 0x15 || p[1] == 0x25)) {
+		int32_t rel = 0;
+		std::memcpy(&rel, p + 2, 4);
+		const uint64_t slot = pc + 6 + static_cast<int64_t>(rel);
+		uint64_t target = 0;
+		std::memcpy(&target, reinterpret_cast<const void*>(slot), sizeof(target));
+		if (target < 0x10000) return 0;
+		out->push_back(0x49);
+		out->push_back(0xBB);
+		for (int i = 0; i < 8; i++) out->push_back(static_cast<uint8_t>(target >> (8 * i)));
+		out->push_back(0x41);
+		out->push_back(0xFF);
+		out->push_back(p[1] == 0x15 ? 0xD3 : 0xE3);
+		return 6;
+	}
+	if (p[0] == 0xC3) {
+		out->push_back(0xC3);
+		return 1;
+	}
+	if (p[0] == 0xE9 || p[0] == 0xE8) {
+		int32_t rel = 0;
+		std::memcpy(&rel, p + 1, 4);
+		const uint64_t target = pc + 5 + static_cast<int64_t>(rel);
+		if (p[0] == 0xE9) {
+			abs_jmp(target);
+		} else {
+			// call [rip+2]; jmp +8; .quad target
+			const uint8_t k[8] = {0xFF, 0x15, 2, 0, 0, 0, 0xEB, 8};
+			out->insert(out->end(), k, k + 8);
+			for (int i = 0; i < 8; i++) out->push_back(static_cast<uint8_t>(target >> (8 * i)));
+		}
+		return 5;
+	}
+	// Position-independent instructions.
+	int  n   = 0;
+	bool rex_w = false;
+	if (p[0] == 0x66) n++;
+	if ((p[n] & 0xF0) == 0x40) {
+		rex_w = (p[n] & 0x08) != 0;
+		n++;
+	}
+	const uint8_t op = p[n];
+	int len = 0;
+	if ((op >= 0x50 && op <= 0x5F) || op == 0x90) {
+		len = n + 1;
+	} else if (op == 0x01 || op == 0x03 || op == 0x09 || op == 0x0B || op == 0x21 || op == 0x23 || op == 0x29 ||
+	           op == 0x2B || op == 0x31 || op == 0x33 || op == 0x39 || op == 0x3B || op == 0x84 || op == 0x85 ||
+	           op == 0x88 || op == 0x89 || op == 0x8A || op == 0x8B || op == 0x8D || op == 0x87 || op == 0x63) {
+		const int m = ModRmLen(p + n + 1);
+		if (m != 0) len = n + 1 + m;
+	} else if (op == 0x83 || op == 0xC6) {
+		const int m = ModRmLen(p + n + 1);
+		if (m != 0) len = n + 1 + m + 1;
+	} else if (op == 0x81 || op == 0xC7) {
+		const int m = ModRmLen(p + n + 1);
+		if (m != 0) len = n + 1 + m + (p[0] == 0x66 ? 2 : 4);
+	} else if (op >= 0xB8 && op <= 0xBF) {
+		len = n + 1 + (rex_w ? 8 : 4);
+	} else if (op == 0x0F && p[n + 1] == 0x1F) {
+		const int m = ModRmLen(p + n + 2);
+		if (m != 0) len = n + 2 + m;
+	}
+	if (len == 0) return 0;
+	out->insert(out->end(), p, p + len);
+	return len;
+}
+
+// Builds `<relocated first instructions of fn> ; jmp fn+N` so the original function stays
+// callable after its entry is overwritten. Returns 0 if the entry cannot be relocated.
+uint64_t BuildOriginalTrampoline(uint64_t fn, int min_bytes) {
+	std::vector<uint8_t> out;
+	int copied = 0;
+	bool ended = false; // the copied code ended with ret / jmp: nothing after it runs
+	while (copied < min_bytes && !ended) {
+		const auto* insn = reinterpret_cast<const uint8_t*>(fn + copied);
+		const int n = RelocateInsn(insn, fn + copied, &out);
+		if (n == 0) return 0;
+		ended = insn[0] == 0xC3 || insn[0] == 0xE9 || insn[0] == 0xEB || (insn[0] == 0xFF && insn[1] == 0x25);
+		copied += n;
+	}
+	if (!ended) {
+		const uint64_t back = fn + copied;
+		const uint8_t j[6] = {0xFF, 0x25, 0, 0, 0, 0};
+		out.insert(out.end(), j, j + 6);
+		for (int i = 0; i < 8; i++) out.push_back(static_cast<uint8_t>(back >> (8 * i)));
+	}
+	static uint8_t* page = nullptr;
+	static size_t   used = 0;
+	if (page == nullptr || used + out.size() > 0x1000) {
+		void* m = ::mmap(nullptr, 0x1000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+		if (m == MAP_FAILED) return 0;
+		page = static_cast<uint8_t*>(m);
+		used = 0;
+	}
+	uint8_t* dst = page + used;
+	std::memcpy(dst, out.data(), out.size());
+	used = (used + out.size() + 15) & ~size_t {15};
+	return reinterpret_cast<uint64_t>(dst);
+}
+
+bool Rewrite(uint64_t addr, uint64_t gate) {
+	const uint64_t next = Loader::NovaNextModuleExport(addr);
+	if (next != 0 && next - addr < 14) return false;
+	const uint64_t page = addr & ~uint64_t {0xfff};
+	const uint64_t end  = (addr + 14 + 0xfff) & ~uint64_t {0xfff};
+	if (::mprotect(reinterpret_cast<void*>(page), end - page, PROT_READ | PROT_WRITE) != 0) return false;
+	uint8_t code[14] = {0xFF, 0x25, 0, 0, 0, 0};
+	std::memcpy(code + 6, &gate, 8);
+	std::memcpy(reinterpret_cast<void*>(addr), code, sizeof(code));
+	::mprotect(reinterpret_cast<void*>(page), end - page, PROT_READ);
+#if defined(KYTY_NOVA_FEX)
+	NovaFex::InvalidateGuestCode(addr, 14);
+#endif
+	return true;
+}
+
+// The public free/realloc wrappers are `push rbp; mov rbp,rsp; call [rip+disp]; pop
+// rbp; ret`. Other libc functions can use the same dispatch slot without entering
+// the public wrapper, so redirect the slot as well as the export. Only this known
+// wrapper form is accepted; unfamiliar libc versions retain export-only redirection.
+uint64_t AllocatorDispatchSlot(uint64_t addr) {
+	const auto* p = reinterpret_cast<const uint8_t*>(addr);
+	if (p[0] == 0x55 && p[1] == 0x48 && p[2] == 0x89 && p[3] == 0xE5 &&
+	    p[4] == 0xFF && p[5] == 0x15 && p[10] == 0x5D && p[11] == 0xC3) {
+		int32_t rel = 0;
+		std::memcpy(&rel, p + 6, sizeof(rel));
+		return addr + 10 + static_cast<int64_t>(rel);
+	}
+	return 0;
+}
+
+bool RewriteDispatchSlot(uint64_t slot, uint64_t gate) {
+	if (slot == 0 || (slot & 7u) != 0) return false;
+	// A recognized instruction form does not prove that its slot is writable (RELRO
+	// may protect it). Check the live mapping before either reading or writing it.
+	bool writable = false;
+	if (FILE* maps = std::fopen("/proc/self/maps", "r")) {
+		char line[512];
+		while (std::fgets(line, sizeof(line), maps) != nullptr) {
+			unsigned long long begin = 0, end = 0;
+			char perms[5] {};
+			if (std::sscanf(line, "%llx-%llx %4s", &begin, &end, perms) == 3 &&
+			    slot >= begin && slot < end && end - slot >= sizeof(uint64_t) &&
+			    perms[0] == 'r' && perms[1] == 'w') {
+				writable = true;
+				break;
+			}
+		}
+		std::fclose(maps);
+	}
+	if (!writable) return false;
+	uint64_t original = 0;
+	std::memcpy(&original, reinterpret_cast<const void*>(slot), sizeof(original));
+	if (original < 0x10000) return false;
+	// Relocations already made libc's data segments writable. Do not relax protection
+	// on an unknown segment or touch an unrelated function's dispatch table.
+	std::memcpy(reinterpret_cast<void*>(slot), &gate, sizeof(gate));
+	return true;
+}
+
+void PatchLibc() {
+	struct Entry {
+		const char* nid;
+		uint64_t    fn;
+		int         kind; // 0 allocate, 1 free, 2 realloc, 3 usable size
+	};
+	const Entry entries[] = {
+	    {"gQX+4GDQjpM", reinterpret_cast<uint64_t>(nova_malloc), 0},
+	    {"2X5agFjKxMc", reinterpret_cast<uint64_t>(nova_calloc), 0},
+	    {"Ujf3KzMvRmI", reinterpret_cast<uint64_t>(nova_memalign), 0},
+	    {"2Btkg8k24Zg", reinterpret_cast<uint64_t>(nova_aligned_alloc), 0},
+	    {"cVSk9y8URbc", reinterpret_cast<uint64_t>(nova_posix_memalign), 0},
+	    {"fJnpuVVBbKk", reinterpret_cast<uint64_t>(nova_new), 0},
+	    {"hdm0YfMa7TQ", reinterpret_cast<uint64_t>(nova_new), 0},
+	    {"tIhsqj0qsFE", reinterpret_cast<uint64_t>(nova_free), 1},
+	    {"Y7aJ1uydPMo", reinterpret_cast<uint64_t>(nova_realloc), 2},
+	    {"OGybVuPAhAY", reinterpret_cast<uint64_t>(nova_reallocalign), 2},
+	    {"NDcSfcYZRC8", reinterpret_cast<uint64_t>(nova_malloc_usable_size), 3},
+	    {"ryUxD-60bKM", reinterpret_cast<uint64_t>(nova_new_nothrow), 0},
+	    {"Jh5qUcwiSEk", reinterpret_cast<uint64_t>(nova_new_nothrow), 0},
+	    {"3yxLpdKD0RA", reinterpret_cast<uint64_t>(nova_new_aligned), 0},
+	    {"kn-rKRB0pfY", reinterpret_cast<uint64_t>(nova_new_aligned), 0},
+	    {"iQXBbJbfT5k", reinterpret_cast<uint64_t>(nova_new_aligned_nothrow), 0},
+	    {"s2eGsgUF9vk", reinterpret_cast<uint64_t>(nova_new_aligned_nothrow), 0},
+	    {"z+P+xCnWLBk", reinterpret_cast<uint64_t>(nova_delete), 0},
+	    {"MLWl90SFWNE", reinterpret_cast<uint64_t>(nova_delete), 0},
+	    {"McsGnqV6yRE", reinterpret_cast<uint64_t>(nova_delete_2), 0},
+	    {"m-fSo3EbxNA", reinterpret_cast<uint64_t>(nova_delete_2), 0},
+	    {"lYDzBVE5mZs", reinterpret_cast<uint64_t>(nova_delete_2), 0},
+	    {"FOt55ZNaVJk", reinterpret_cast<uint64_t>(nova_delete_2), 0},
+	    {"bZx+FFSlkUM", reinterpret_cast<uint64_t>(nova_delete_2), 0},
+	    {"v09ZcAhZzSc", reinterpret_cast<uint64_t>(nova_delete_2), 0},
+	    {"nwujzxOPXzQ", reinterpret_cast<uint64_t>(nova_delete_3), 0},
+	    {"Y1RR+IQy6Pg", reinterpret_cast<uint64_t>(nova_delete_3), 0},
+	};
+	int done = 0;
+	int slots = 0;
+	for (const auto& e: entries) {
+		const uint64_t addr = Loader::NovaFindModuleExport(e.nid);
+		if (addr == 0) continue;
+		const auto* b = reinterpret_cast<const uint8_t*>(addr);
+		const uint64_t slot = AllocatorDispatchSlot(addr);
+		if (e.kind != 0) {
+			uint64_t original = ThunkTarget(addr);
+			if (original == 0) {
+				// A real function: keep it callable for pointers libc handed out before the
+				// redirection, through a copy of its first instructions.
+				original = BuildOriginalTrampoline(addr, 14);
+			}
+			if (original == 0) {
+				std::fprintf(stderr,
+				             "NOVA_HEAP: libc %s at 0x%llx cannot be relocated (%02x %02x %02x %02x %02x %02x %02x %02x "
+				             "%02x %02x %02x %02x %02x %02x %02x %02x), left as is\n",
+				             e.nid, static_cast<unsigned long long>(addr), b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+				             b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+				continue;
+			}
+			if (e.kind == 1) g_libc_free = original;
+			if (e.kind == 2 && std::strcmp(e.nid, "Y7aJ1uydPMo") == 0) g_libc_realloc = original;
+			if (e.kind == 3) g_libc_usable = original;
+		}
+		const uint64_t gate = Libs::NovaExportAddress(e.fn, Loader::SymbolType::Func);
+		if (Rewrite(addr, gate)) {
+			done++;
+			if (RewriteDispatchSlot(slot, gate)) slots++;
+		} else {
+			std::fprintf(stderr, "NOVA_HEAP: could not redirect libc %s at 0x%llx\n", e.nid, static_cast<unsigned long long>(addr));
+		}
+	}
+	std::fprintf(stderr, "NOVA_HEAP: %d libc.prx allocator entry points now use the emulator heap\n", done);
+	std::fprintf(stderr, "NOVA_HEAP: %d internal allocator dispatch slots redirected\n", slots);
+}
+
