@@ -0,0 +1,177 @@
+// Nova PS5 on Android: process setup and the on-screen PS5 controller.
+#if defined(KYTY_ANDROID)
+
+#include <SDL3/SDL.h>
+#include <android/log.h>
+#include <android/native_window.h>
+#include <dlfcn.h>
+#define VK_USE_PLATFORM_ANDROID_KHR 1
+#include <vulkan/vulkan.h>
+#if defined(NOVA_ADRENOTOOLS)
+#include <adrenotools/driver.h>
+#endif
+#include <fcntl.h>
+#include <jni.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <atomic>
+#include <mutex>
+
+void NovaAndroidStartup() {
+	// Kyty reports everything on stdout/stderr; an Android app's streams go nowhere, so they are
+	// sent to the session log the app shows and exports.
+	if (const char* log = getenv("NOVA_LOG_FILE"); log != nullptr && log[0] != 0) {
+		const int fd = open(log, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+		if (fd >= 0) {
+			dup2(fd, STDOUT_FILENO);
+			dup2(fd, STDERR_FILENO);
+			close(fd);
+		}
+		setvbuf(stdout, nullptr, _IOLBF, 0);
+		setvbuf(stderr, nullptr, _IONBF, 0);
+	}
+	if (const char* dir = getenv("NOVA_WORKDIR"); dir != nullptr && dir[0] != 0) {
+		if (chdir(dir) != 0) {
+			std::fprintf(stderr, "NOVA_ANDROID: cannot enter %s\n", dir);
+		}
+	}
+	const time_t now = time(nullptr);
+	std::fprintf(stderr, "NOVA_ANDROID: Kyty started in the app process (pid %d) %s", static_cast<int>(getpid()),
+	             ctime(&now));
+	__android_log_print(ANDROID_LOG_INFO, "NovaPS5", "Kyty started (pid %d)", static_cast<int>(getpid()));
+}
+
+namespace {
+PFN_vkGetInstanceProcAddr g_gipa = nullptr;
+std::atomic<long long>    g_frames {0};
+} // namespace
+
+// Presented frames, for the app's FPS overlay.
+void NovaAndroidNoteFrame() {
+	g_frames.fetch_add(1, std::memory_order_relaxed);
+}
+
+extern "C" JNIEXPORT jlong JNICALL Java_com_kaminofilms_novaps5_NovaPad_nativeFrames(JNIEnv*, jclass) {
+	return static_cast<jlong>(g_frames.load(std::memory_order_relaxed));
+}
+
+// The Vulkan driver: a Turnip build loaded through adrenotools when the app selected one
+// (NOVA_TURNIP_DIR/NOVA_TURNIP_LIB, hook libraries in NOVA_HOOK_DIR), otherwise the system driver.
+PFN_vkGetInstanceProcAddr NovaAndroidVulkanLoader(PFN_vkGetInstanceProcAddr fallback) {
+	if (g_gipa != nullptr) {
+		return g_gipa;
+	}
+#if defined(NOVA_ADRENOTOOLS)
+	const char* dir  = getenv("NOVA_TURNIP_DIR");
+	const char* lib  = getenv("NOVA_TURNIP_LIB");
+	const char* hook = getenv("NOVA_HOOK_DIR");
+	if (dir != nullptr && dir[0] != 0 && lib != nullptr && lib[0] != 0 && hook != nullptr) {
+		void* handle = adrenotools_open_libvulkan(RTLD_NOW, ADRENOTOOLS_DRIVER_CUSTOM, nullptr, hook, dir, lib,
+		                                          nullptr, nullptr);
+		if (handle != nullptr) {
+			g_gipa = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(handle, "vkGetInstanceProcAddr"));
+		}
+		std::fprintf(stderr, "NOVA_ANDROID: GPU driver %s%s: %s\n", dir, lib,
+		             g_gipa != nullptr ? "loaded (adrenotools)" : "FAILED, using the system driver");
+	}
+#endif
+	if (g_gipa == nullptr) {
+		g_gipa = fallback;
+		std::fprintf(stderr, "NOVA_ANDROID: GPU driver: system Vulkan\n");
+	}
+	return g_gipa;
+}
+
+bool NovaAndroidCreateSurface(SDL_Window* window, VkInstance instance, const VkAllocationCallbacks* allocator,
+                              VkSurfaceKHR* surface) {
+	auto* native = static_cast<ANativeWindow*>(
+	    SDL_GetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, nullptr));
+	if (native == nullptr || g_gipa == nullptr) {
+		SDL_SetError("no Android window for Vulkan");
+		return false;
+	}
+	auto create = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(g_gipa(instance, "vkCreateAndroidSurfaceKHR"));
+	if (create == nullptr) {
+		SDL_SetError("vkCreateAndroidSurfaceKHR unavailable");
+		return false;
+	}
+	VkAndroidSurfaceCreateInfoKHR info {};
+	info.sType  = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+	info.window = native;
+	const VkResult result = create(instance, &info, allocator, surface);
+	if (result != VK_SUCCESS) {
+		SDL_SetError("vkCreateAndroidSurfaceKHR failed: %d", static_cast<int>(result));
+		return false;
+	}
+	return true;
+}
+
+namespace {
+
+std::mutex     g_pad_mutex;
+SDL_Joystick*  g_pad          = nullptr;
+int            g_last_buttons = -1;
+Sint16         g_last_axes[SDL_GAMEPAD_AXIS_COUNT] {};
+
+// The touch controller is an SDL virtual gamepad, so Kyty sees it exactly like a real pad.
+bool EnsurePad() {
+	if (g_pad != nullptr) {
+		return true;
+	}
+	if (!SDL_WasInit(SDL_INIT_JOYSTICK)) {
+		return false;
+	}
+	SDL_VirtualJoystickDesc desc;
+	SDL_INIT_INTERFACE(&desc);
+	desc.type     = SDL_JOYSTICK_TYPE_GAMEPAD;
+	desc.naxes    = SDL_GAMEPAD_AXIS_COUNT;
+	desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+	desc.name     = "Nova touch controller";
+	const SDL_JoystickID id = SDL_AttachVirtualJoystick(&desc);
+	if (id == 0) {
+		std::fprintf(stderr, "NOVA_ANDROID: touch controller unavailable: %s\n", SDL_GetError());
+		return false;
+	}
+	g_pad = SDL_OpenJoystick(id);
+	std::fprintf(stderr, "NOVA_ANDROID: touch controller attached (%s)\n", g_pad != nullptr ? "ok" : SDL_GetError());
+	return g_pad != nullptr;
+}
+
+Sint16 Axis(float value) {
+	if (value < -1.0f) value = -1.0f;
+	if (value > 1.0f) value = 1.0f;
+	return static_cast<Sint16>(value * 32767.0f);
+}
+
+} // namespace
+
+// buttons: bit n = SDL_GamepadButton n. Sticks -1..1, triggers 0..1.
+extern "C" JNIEXPORT void JNICALL Java_com_kaminofilms_novaps5_NovaPad_nativeState(JNIEnv*, jclass, jint buttons, jfloat lx,
+                                                                                    jfloat ly, jfloat rx, jfloat ry,
+                                                                                    jfloat l2, jfloat r2) {
+	std::lock_guard lock(g_pad_mutex);
+	if (!EnsurePad()) {
+		return;
+	}
+	if (buttons != g_last_buttons) {
+		for (int b = 0; b < SDL_GAMEPAD_BUTTON_COUNT && b < 31; b++) {
+			const bool down = ((buttons >> b) & 1) != 0;
+			if (g_last_buttons < 0 || down != (((g_last_buttons >> b) & 1) != 0)) {
+				SDL_SetJoystickVirtualButton(g_pad, b, down);
+			}
+		}
+		g_last_buttons = buttons;
+	}
+	const Sint16 axes[SDL_GAMEPAD_AXIS_COUNT] = {Axis(lx), Axis(ly), Axis(rx), Axis(ry), Axis(l2), Axis(r2)};
+	for (int a = 0; a < SDL_GAMEPAD_AXIS_COUNT; a++) {
+		if (axes[a] != g_last_axes[a]) {
+			SDL_SetJoystickVirtualAxis(g_pad, a, axes[a]);
+			g_last_axes[a] = axes[a];
+		}
+	}
+}
+
+#endif
