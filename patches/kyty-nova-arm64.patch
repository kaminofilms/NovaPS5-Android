diff --git a/src/common/hostException.cpp b/src/common/hostException.cpp
index d44c623c..54f512cd 100644
--- a/src/common/hostException.cpp
+++ b/src/common/hostException.cpp
@@ -10,7 +10,9 @@
 #include <csignal>
