+// A fault the handler reports as handled but that recurs immediately at the same instruction and
+// address never makes progress: the thread spins in the handler and the game freezes without a
+// message. Hundreds of identical faults within a fraction of a second are that loop. A page fault
+// is broken by making the page accessible (the GPU cache may then miss one CPU write, which is far
+// better than a frozen game); anything else is reported and ends the process.
+// Returns true when the fault cannot be broken and the default action should follow.
+static bool IsGuestReadable(uint64_t address) {
+	return address >= 0x10000;
+}
+
+static bool FaultLoops(int signal_number, const ucontext_t* context, const ExceptionInfo& info) {
+	struct Repeat {
+		uint64_t pc;
+		uint64_t address;
+		uint64_t since_ns;
+		uint32_t count;
+	};
+	static thread_local Repeat repeat {};
+	static std::atomic<uint32_t> broken {0};
+	timespec now {};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	const uint64_t now_ns = static_cast<uint64_t>(now.tv_sec) * 1000000000ull + static_cast<uint64_t>(now.tv_nsec);
+	if (repeat.pc != info.exception_address || repeat.address != info.access_violation_vaddr ||
+	    now_ns - repeat.since_ns > 250000000ull) {
+		repeat = {info.exception_address, info.access_violation_vaddr, now_ns, 1};
+		return false;
+	}
+	if (++repeat.count < 512) {
+		return false;
+	}
+	repeat.count = 0;
+	const auto     esr         = ReadEsr(context);
+	const uint32_t instruction = IsGuestReadable(info.exception_address) ? *reinterpret_cast<const uint32_t*>(info.exception_address) : 0;
+	std::fprintf(stderr,
+	             "NOVA_FAULT_LOOP: signal=%d pc=0x%016llx address=0x%016llx esr=0x%llx insn=0x%08x access=%u\n",
+	             signal_number, static_cast<unsigned long long>(info.exception_address),
+	             static_cast<unsigned long long>(info.access_violation_vaddr), static_cast<unsigned long long>(esr),
+	             instruction, static_cast<unsigned>(info.access_violation_type));
+	if (signal_number != SIGSEGV) {
+		return true;
+	}
+	const auto page = static_cast<uint64_t>(sysconf(_SC_PAGESIZE));
+	const auto base = info.access_violation_vaddr & ~(page - 1);
+	if (mprotect(reinterpret_cast<void*>(base), page, PROT_READ | PROT_WRITE) != 0) {
+		return true;
