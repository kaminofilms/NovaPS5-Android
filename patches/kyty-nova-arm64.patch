--- /dev/null
+++ b/src/kernel/novaMemoryCompatibility.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstdint>
+
+namespace Libs::LibKernel::Memory {
+
+// Placement alignment normally applies to MAP_FIXED too. A title-specific opt-in
+// can instead use the guest page alignment; it never permits null, wrapping, or
+// sub-page addresses. Physical backing and ownership checks remain in memory.cpp.
+inline bool NovaValidDirectFixedAddress(uint64_t address, uint64_t size,
+                                       uint64_t alignment, bool page_placement) {
+	constexpr uint64_t page = 0x4000;
+	return address != 0 && (address & (page - 1)) == 0 &&
+	       size != 0 && size <= UINT64_MAX - address &&
+	       (page_placement || alignment == 0 || address % alignment == 0);
+}
+
+} // namespace Libs::LibKernel::Memory
