+	LIB_FUNC("s2eGsgUF9vk", nova_new_aligned_nothrow);  // _ZnamSt11align_val_tRKSt9nothrow_t
+	LIB_FUNC("z+P+xCnWLBk", nova_delete);               // _ZdlPv
+	LIB_FUNC("MLWl90SFWNE", nova_delete);               // _ZdaPv
+	LIB_FUNC("McsGnqV6yRE", nova_delete_2);             // _ZdlPvRKSt9nothrow_t
+	LIB_FUNC("m-fSo3EbxNA", nova_delete_2);             // _ZdaPvRKSt9nothrow_t
+	LIB_FUNC("lYDzBVE5mZs", nova_delete_2);             // _ZdlPvm
+	LIB_FUNC("FOt55ZNaVJk", nova_delete_2);             // _ZdaPvm
+	LIB_FUNC("bZx+FFSlkUM", nova_delete_2);             // _ZdlPvSt11align_val_t
+	LIB_FUNC("v09ZcAhZzSc", nova_delete_2);             // _ZdaPvSt11align_val_t
