+bool Overrides(const std::string& nid) {
+	static const char* const kNids[] = {"gQX+4GDQjpM", "tIhsqj0qsFE", "2X5agFjKxMc", "Y7aJ1uydPMo", "Ujf3KzMvRmI", "2Btkg8k24Zg", "cVSk9y8URbc", "OGybVuPAhAY", "NDcSfcYZRC8", "fJnpuVVBbKk", "hdm0YfMa7TQ", "ryUxD-60bKM", "Jh5qUcwiSEk", "3yxLpdKD0RA", "kn-rKRB0pfY", "iQXBbJbfT5k", "s2eGsgUF9vk", "z+P+xCnWLBk", "MLWl90SFWNE", "McsGnqV6yRE", "m-fSo3EbxNA", "lYDzBVE5mZs", "FOt55ZNaVJk", "bZx+FFSlkUM", "v09ZcAhZzSc", "nwujzxOPXzQ", "Y1RR+IQy6Pg"};
+	if (!g_registered) return false;
+	for (const char* n: kNids) {
