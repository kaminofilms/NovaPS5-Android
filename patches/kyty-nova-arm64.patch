+// Guest code is never executed by the AArch64 host CPU (FEXCore translates it); executable
+// guest mappings are readable instead, so a stray host jump into them faults and is bridged.
+#if defined(__aarch64__)
+#define KYTY_GUEST_PROT_EXEC PROT_READ
+#else
+#define KYTY_GUEST_PROT_EXEC PROT_EXEC
+#endif
