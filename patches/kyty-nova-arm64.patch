+// Nova PS5 on Android: what bionic does not provide. Force-included into Kyty's own sources only.
+#ifndef KYTY_COMMON_NOVA_BIONIC_H_
+#define KYTY_COMMON_NOVA_BIONIC_H_
+#if defined(__ANDROID__) && defined(__cplusplus)
+
+#include <pthread.h>
+
+#include <mutex>
+#include <unordered_set>
+
+// bionic has no thread cancellation. Deferred cancellation is emulated: a request is honored when
+// the target thread reaches a cancellation point it calls itself (pthread_testcancel).
+#ifndef PTHREAD_CANCEL_ENABLE
+#define PTHREAD_CANCEL_ENABLE  0
+#define PTHREAD_CANCEL_DISABLE 1
+#endif
+#ifndef PTHREAD_CANCEL_DEFERRED
+#define PTHREAD_CANCEL_DEFERRED     0
+#define PTHREAD_CANCEL_ASYNCHRONOUS 1
+#endif
+#ifndef PTHREAD_CANCELED
+#define PTHREAD_CANCELED (reinterpret_cast<void*>(-1))
+#endif
+
+#ifndef PTHREAD_MUTEX_FAST_NP
+#define PTHREAD_MUTEX_FAST_NP PTHREAD_MUTEX_NORMAL
+#endif
+
+#ifndef PTHREAD_PRIO_PROTECT
+#define PTHREAD_PRIO_PROTECT 2
+#endif
+
+#include <linux/close_range.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#ifndef CLOSE_RANGE_CLOEXEC
+#define CLOSE_RANGE_CLOEXEC (1U << 2)
+#endif
+inline int close_range(unsigned int first, unsigned int last, int flags) {
+	return static_cast<int>(syscall(__NR_close_range, first, last, flags));
+}
+
+namespace NovaBionic {
+inline std::mutex& CancelMutex() {
+	static std::mutex mutex;
+	return mutex;
+}
+inline std::unordered_set<pthread_t>& CancelPending() {
+	static std::unordered_set<pthread_t> pending;
+	return pending;
+}
+inline thread_local int t_cancel_state = PTHREAD_CANCEL_ENABLE;
+inline thread_local int t_cancel_type  = PTHREAD_CANCEL_DEFERRED;
+// Kyty installs its own thread exit (guest threads must not unwind through translated code).
+inline void (*g_cancel_exit)(void*) = nullptr;
+
+inline bool TakeCancel() {
+	if (t_cancel_state != PTHREAD_CANCEL_ENABLE) {
+		return false;
+	}
+	std::lock_guard lock(CancelMutex());
+	return CancelPending().erase(pthread_self()) != 0;
+}
+} // namespace NovaBionic
+
+inline int pthread_cancel(pthread_t thread) {
+	std::lock_guard lock(NovaBionic::CancelMutex());
+	NovaBionic::CancelPending().insert(thread);
+	return 0;
+}
+inline int pthread_setcancelstate(int state, int* old_state) {
+	if (old_state != nullptr) *old_state = NovaBionic::t_cancel_state;
+	NovaBionic::t_cancel_state = state;
+	return 0;
+}
+inline int pthread_setcanceltype(int type, int* old_type) {
+	if (old_type != nullptr) *old_type = NovaBionic::t_cancel_type;
+	NovaBionic::t_cancel_type = type;
+	return 0;
+}
+inline void pthread_testcancel() {
+	if (NovaBionic::TakeCancel()) {
+		if (NovaBionic::g_cancel_exit != nullptr) NovaBionic::g_cancel_exit(PTHREAD_CANCELED);
+		pthread_exit(PTHREAD_CANCELED);
+	}
+}
+
+#endif
+#endif /* KYTY_COMMON_NOVA_BIONIC_H_ */
