+			}
+		}
+		g_last_buttons = buttons;
+	}
+	const Sint16 axes[SDL_GAMEPAD_AXIS_COUNT] = {Axis(lx), Axis(ly), Axis(rx), Axis(ry), Axis(l2), Axis(r2)};
