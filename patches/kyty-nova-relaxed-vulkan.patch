+// Nova lab: NOVA_RELAXED_VULKAN=1 downgrades features that software drivers lack
+// (lavapipe) to warnings so CPU-side boot can be observed. Rendering is then incomplete.
+static bool NovaRelaxedVulkan() {
+	static const bool relaxed = [] {
+		const char* value = std::getenv("NOVA_RELAXED_VULKAN");
+		return value != nullptr && value[0] == '1';
+	}();
+	return relaxed;
+}
+
+static bool NovaRelaxable(const char* name) {
+	return NovaRelaxedVulkan() &&
+	       (strcmp(name, "image view minLod") == 0 || strcmp(name, "fragmentShaderBarycentric") == 0 ||
+	        strcmp(name, "depthBounds") == 0 || strcmp(name, VK_EXT_IMAGE_VIEW_MIN_LOD_EXTENSION_NAME) == 0 ||
+	        strcmp(name, VK_KHR_FRAGMENT_SHADER_BARYCENTRIC_EXTENSION_NAME) == 0);
+}
+
+static bool g_nova_barycentric_enabled = true;
+static bool g_nova_depth_bounds_enabled = true;
