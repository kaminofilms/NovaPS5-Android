+DEF_OP(NovaXlat) {
+  // Nova PS5 (see FEXCore/Core/NovaGuestVA.h): host = guest for addresses below 2^39,
+  // otherwise guest + GuestVATable[guest >> 30].
+  const auto Op = IROp->C<IR::IROp_NovaXlat>();
+  const auto Src = GetReg(Op->Addr);
+  const auto Dst = GetReg(Node);
+  ARMEmitter::ForwardLabel High;
+  ARMEmitter::ForwardLabel Done;
+  ubfx(ARMEmitter::Size::i64Bit, TMP1, Src, 39, 25);
+  (void)cbnz(ARMEmitter::Size::i64Bit, TMP1, &High);
+  if (Dst != Src) {
+    mov(ARMEmitter::Size::i64Bit, Dst, Src);
+  }
+  (void)b(&Done);
+  (void)Bind(&High);
+  ubfx(ARMEmitter::Size::i64Bit, TMP1, Src, FEXCore::Nova::kGuestVASlotShift, 17);
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP2, reinterpret_cast<uint64_t>(&FEXCore::Nova::GuestVATable[0]));
+  ldr(TMP1.X(), ARMEmitter::ExtendedMemOperand(TMP2.X(), TMP1.X(), ARMEmitter::ExtendedType::LSL_64, 3));
+  add(ARMEmitter::Size::i64Bit, Dst, Src, TMP1);
+  (void)Bind(&Done);
+}
