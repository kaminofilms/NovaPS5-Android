diff --git a/FEXCore/Source/Interface/IR/Passes/NovaAddressTranslationPass.cpp b/FEXCore/Source/Interface/IR/Passes/NovaAddressTranslationPass.cpp
new file mode 100644
index 000000000..0464534b4
--- /dev/null
+++ b/FEXCore/Source/Interface/IR/Passes/NovaAddressTranslationPass.cpp
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: MIT
+// Nova PS5: routes the address of every guest memory access through NovaXlat (see
+// FEXCore/Core/NovaGuestVA.h). Folded register/immediate offsets are added first, so the
+// translated value is the complete effective address and the access uses no further offset.
+#include "Interface/IR/IR.h"
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/PassManager.h"
+#include "FEXCore/Utils/MathUtils.h"
+#include <FEXCore/Core/NovaGuestVA.h>
+#include <FEXCore/Utils/Profiler.h>
+
+namespace FEXCore::IR {
+namespace {
+class NovaAddressTranslation final : public Pass {
+public:
+  void Run(IREmitter* IREmit) override;
+
+private:
+  IREmitter* Emit {};
+
+  // Effective address = Addr + extend(Offset) << log2(Scale), computed before Node.
+  Ref EffectiveAddress(OrderedNodeWrapper AddrW, OrderedNodeWrapper OffsetW, MemOffsetType Type, uint8_t Scale) {
+    Ref Addr = Emit->UnwrapNode(AddrW);
+    if (OffsetW.IsInvalid()) {
+      return Addr;
+    }
+    const uint32_t Shift = Scale > 1 ? FEXCore::ilog2(Scale) : 0;
+    uint64_t Const {};
+    if (Emit->IsValueConstant(OffsetW, &Const) || Emit->IsValueInlineConstant(OffsetW)) {
+      if (Emit->IsValueInlineConstant(OffsetW)) {
+        const auto* Header = Emit->GetOpHeader(OffsetW);
+        Const = Header->C<IROp_InlineConstant>()->Constant;
+      }
+      int64_t Value = static_cast<int64_t>(Const);
+      if (Type == MemOffsetType::UXTW) {
+        Value = static_cast<int64_t>(static_cast<uint32_t>(Const));
+      } else if (Type == MemOffsetType::SXTW) {
+        Value = static_cast<int32_t>(Const);
+      }
+      Value = static_cast<int64_t>(static_cast<uint64_t>(Value) << Shift);
+      return Value == 0 ? Addr : Emit->Add(OpSize::i64Bit, Addr, Emit->Constant(Value));
+    }
+    Ref Offset = Emit->UnwrapNode(OffsetW);
+    if (Type == MemOffsetType::UXTW) {
+      Offset = Emit->_Bfe(OpSize::i64Bit, 32, 0, Offset);
+    } else if (Type == MemOffsetType::SXTW) {
+      Offset = Emit->_Sbfe(OpSize::i64Bit, 32, 0, Offset);
+    }
+    return Emit->_AddShift(OpSize::i64Bit, Addr, Offset, ShiftType::LSL, Shift);
+  }
+
+  void Rewrite(Ref Node, uint8_t AddrIndex, Ref EA) {
+    Ref Xlat = Emit->_NovaXlat(EA);
+    Emit->ReplaceNodeArgument(Node, AddrIndex, Xlat);
+  }
+
+  template<typename T>
+  void WithOffset(Ref Node, const IROp_Header* IROp) {
+    auto* Op = IROp->C<T>();
+    Emit->SetWriteCursorBefore(Node);
+    Ref EA = EffectiveAddress(Op->Addr, Op->Offset, Op->OffsetType, Op->OffsetScale);
+    Rewrite(Node, T::Addr_Index, EA);
+    if (!Op->Offset.IsInvalid()) {
+      Emit->ReplaceNodeArgument(Node, T::Offset_Index, Emit->Invalid());
+    }
+  }
+
+  template<typename T>
+  void Plain(Ref Node, const IROp_Header* IROp) {
+    auto* Op = IROp->C<T>();
+    Emit->SetWriteCursorBefore(Node);
+    Rewrite(Node, T::Addr_Index, Emit->UnwrapNode(Op->Addr));
+  }
+};
+
+void NovaAddressTranslation::Run(IREmitter* IREmit) {
+  if (!FEXCore::Nova::GuestVAEnabled) {
+    return;
+  }
+  FEXCORE_PROFILE_SCOPED("PassManager::NovaAddressTranslation");
+  Emit = IREmit;
+  auto CurrentIR = IREmit->ViewIR();
+  for (auto [BlockNode, BlockHeader] : CurrentIR.GetBlocks()) {
+    IREmit->SetCurrentCodeBlock(BlockNode);
+    for (auto [CodeNode, IROp] : CurrentIR.GetCode(BlockNode)) {
+      switch (IROp->Op) {
+      case OP_LOADMEM: WithOffset<IROp_LoadMem>(CodeNode, IROp); break;
+      case OP_STOREMEM: WithOffset<IROp_StoreMem>(CodeNode, IROp); break;
+      case OP_LOADMEMTSO: WithOffset<IROp_LoadMemTSO>(CodeNode, IROp); break;
+      case OP_STOREMEMTSO: WithOffset<IROp_StoreMemTSO>(CodeNode, IROp); break;
+      case OP_VLOADVECTORMASKED: WithOffset<IROp_VLoadVectorMasked>(CodeNode, IROp); break;
+      case OP_VSTOREVECTORMASKED: WithOffset<IROp_VStoreVectorMasked>(CodeNode, IROp); break;
+      case OP_LOADMEMPAIR: Plain<IROp_LoadMemPair>(CodeNode, IROp); break;
+      case OP_STOREMEMPAIR: Plain<IROp_StoreMemPair>(CodeNode, IROp); break;
+      case OP_LOADMEMX87SVEOPTPREDICATE: Plain<IROp_LoadMemX87SVEOptPredicate>(CodeNode, IROp); break;
+      case OP_STOREMEMX87SVEOPTPREDICATE: Plain<IROp_StoreMemX87SVEOptPredicate>(CodeNode, IROp); break;
+      case OP_VLOADVECTORELEMENT: Plain<IROp_VLoadVectorElement>(CodeNode, IROp); break;
+      case OP_VSTOREVECTORELEMENT: Plain<IROp_VStoreVectorElement>(CodeNode, IROp); break;
+      case OP_VLOADNONTEMPORAL: Plain<IROp_VLoadNonTemporal>(CodeNode, IROp); break;
+      case OP_VSTORENONTEMPORAL: Plain<IROp_VStoreNonTemporal>(CodeNode, IROp); break;
+      case OP_VSTORENONTEMPORALPAIR: Plain<IROp_VStoreNonTemporalPair>(CodeNode, IROp); break;
+      case OP_CAS: Plain<IROp_CAS>(CodeNode, IROp); break;
+      case OP_CASPAIR: Plain<IROp_CASPair>(CodeNode, IROp); break;
+      case OP_ATOMICSWAP: Plain<IROp_AtomicSwap>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHADD: Plain<IROp_AtomicFetchAdd>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHSUB: Plain<IROp_AtomicFetchSub>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHAND: Plain<IROp_AtomicFetchAnd>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHCLR: Plain<IROp_AtomicFetchCLR>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHOR: Plain<IROp_AtomicFetchOr>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHXOR: Plain<IROp_AtomicFetchXor>(CodeNode, IROp); break;
+      case OP_ATOMICFETCHNEG: Plain<IROp_AtomicFetchNeg>(CodeNode, IROp); break;
+      case OP_VBROADCASTFROMMEM: {
+        auto* Op = IROp->C<IROp_VBroadcastFromMem>();
+        IREmit->SetWriteCursorBefore(CodeNode);
+        Rewrite(CodeNode, IROp_VBroadcastFromMem::Address_Index, IREmit->UnwrapNode(Op->Address));
+        break;
+      }
+      default: break;
+      }
+    }
+  }
+}
+} // namespace
+
+fextl::unique_ptr<Pass> CreateNovaAddressTranslationPass() {
+  return fextl::make_unique<NovaAddressTranslation>();
+}
+} // namespace FEXCore::IR
diff --git a/FEXCore/include/FEXCore/Core/NovaGuestVA.h b/FEXCore/include/FEXCore/Core/NovaGuestVA.h
new file mode 100644
index 000000000..481c84c8b
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/NovaGuestVA.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+// Nova PS5: guest virtual addresses above the host's address space.
+//
+// Android ARM64 kernels commonly give an app a 39-bit (512 GiB) address space while PS5 titles
+// use addresses up to 1 TiB and more (libc's 512/768 GiB arena puts data at its top). When
+// enabled, every guest memory access goes through NovaXlat: addresses below 2^39 are used as is
+// (identity, zero cost beyond one test), higher ones are rebased per 1 GiB slot through
+// GuestVATable (host = guest + delta). A zero delta leaves the address unmapped (it faults).
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace FEXCore::Nova {
+constexpr uint64_t kGuestVALowLimit = uint64_t {1} << 39;
+constexpr uint32_t kGuestVASlotShift = 30;
+constexpr size_t kGuestVASlots = size_t {1} << 17; // 2^47 / 1 GiB
+
+extern uint64_t GuestVATable[kGuestVASlots];
+extern bool GuestVAEnabled;
+} // namespace FEXCore::Nova
