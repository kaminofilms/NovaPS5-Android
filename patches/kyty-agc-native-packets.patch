+// A native alias is valid only while this CommandBuffer fits in one guest slot.
+// Grow callbacks must receive the original guest object, never its host alias.
+static uint32_t* allocate_guest_packet(CommandBuffer* guest_buf, uint32_t size_dw) {
+	auto* host_buf = GuestMemory::Ptr(guest_buf, sizeof(CommandBuffer));
+	if (host_buf != guest_buf && size_dw != 0 && host_buf->GetAvailableSizeDW() >= size_dw) {
+		auto* result = host_buf->cursor_up;
+		host_buf->cursor_up += size_dw;
+		return result;
+	}
+	return guest_buf->AllocateDW(size_dw);
+}
