+#pragma once
+#include <cstdlib>
+#include <string_view>
+namespace NovaEverBda {
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* title = std::getenv("NOVA_CACHE_TITLE_ID");
+        const char* override = std::getenv("NOVA_EVER_BDA_SYNC");
+        return title && std::string_view(title)=="PPSA04703" &&
+               (!override || std::string_view(override)!="0");
+    }();
+    return enabled;
+}
