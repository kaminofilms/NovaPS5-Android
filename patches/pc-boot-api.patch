+	Common::LockGuard lock(m_mutex);
+	if (d < 0) return {};
+	if (d < 3) return m_standard_pipes[d];
+	const auto index = static_cast<size_t>(d - 3);
+	return index < m_files.size() && m_files[index] != nullptr ? m_files[index]->pipe : nullptr;
