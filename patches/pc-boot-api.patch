diff --git a/src/kernel/guestPipe.h b/src/kernel/guestPipe.h
new file mode 100644
index 0000000..4c8767b
--- /dev/null
+++ b/src/kernel/guestPipe.h
@@ -0,0 +1,108 @@
+#ifndef KYTY_KERNEL_GUEST_PIPE_H_
+#define KYTY_KERNEL_GUEST_PIPE_H_
+
+#include <algorithm>
+#include <array>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+namespace Libs::LibKernel::FileSystem {
+
+// Guest errno values, independent of the host CRT (FreeBSD EAGAIN is 35).
+class GuestPipe {
+public:
+  static constexpr size_t Capacity = 65536;
+  static constexpr size_t AtomicWrite = 4096;
+  struct State {
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::array<uint8_t, Capacity> data {};
+    size_t head = 0, size = 0;
+    bool reader_open = true, writer_open = true;
+  };
+
+  GuestPipe(std::shared_ptr<State> state, bool reader, bool nonblocking)
+      : m_state(std::move(state)), m_reader(reader), m_nonblocking(nonblocking) {}
+  GuestPipe(const GuestPipe&) = delete;
+  GuestPipe& operator=(const GuestPipe&) = delete;
+  ~GuestPipe() {
+    std::lock_guard lock(m_state->mutex);
+    (m_reader ? m_state->reader_open : m_state->writer_open) = false;
+    m_state->changed.notify_all();
+  }
+
+  bool Reader() const { return m_reader; }
+  bool Nonblocking() const {
+    std::lock_guard lock(m_state->mutex);
+    return m_nonblocking;
+  }
+  void SetNonblocking(bool value) {
+    std::lock_guard lock(m_state->mutex);
+    m_nonblocking = value;
+    m_state->changed.notify_all();
+  }
+
+  int64_t Read(void* buffer, size_t count) {
+    if (!m_reader) return -9;
+    if (count == 0) return 0;
+    std::unique_lock lock(m_state->mutex);
+    while (m_state->size == 0 && m_state->writer_open) {
+      if (m_nonblocking) return -35;
+      m_state->changed.wait(lock);
+    }
+    const auto bytes = std::min(count, m_state->size);
+    auto* out = static_cast<uint8_t*>(buffer);
+    const auto first = std::min(bytes, Capacity - m_state->head);
+    std::memcpy(out, m_state->data.data() + m_state->head, first);
+    std::memcpy(out + first, m_state->data.data(), bytes - first);
+    m_state->head = (m_state->head + bytes) % Capacity;
+    m_state->size -= bytes;
+    m_state->changed.notify_all();
+    return static_cast<int64_t>(bytes);
+  }
+
+  int64_t Write(const void* buffer, size_t count) {
+    if (m_reader) return -9;
+    if (count == 0) return 0;
+    std::unique_lock lock(m_state->mutex);
+    const auto* in = static_cast<const uint8_t*>(buffer);
+    size_t written = 0;
+    while (written < count) {
+      if (!m_state->reader_open) return written ? static_cast<int64_t>(written) : -32;
+      const auto free = Capacity - m_state->size;
+      // PIPE_BUF writes stay together; large writes may make partial progress.
+      if (free == 0 || (count <= AtomicWrite && free < count)) {
+        if (m_nonblocking) return written ? static_cast<int64_t>(written) : -35;
+        m_state->changed.wait(lock);
+        continue;
+      }
+      const auto bytes = std::min(count - written, free);
+      const auto tail = (m_state->head + m_state->size) % Capacity;
+      const auto first = std::min(bytes, Capacity - tail);
+      std::memcpy(m_state->data.data() + tail, in + written, first);
+      std::memcpy(m_state->data.data(), in + written + first, bytes - first);
+      m_state->size += bytes;
+      written += bytes;
+      m_state->changed.notify_all();
+    }
+    return static_cast<int64_t>(written);
+  }
+
+  static auto Create(bool nonblocking) {
+    auto state = std::make_shared<State>();
+    return std::make_pair(std::make_shared<GuestPipe>(state, true, nonblocking),
+                          std::make_shared<GuestPipe>(state, false, nonblocking));
+  }
+
+private:
+  std::shared_ptr<State> m_state;
+  bool m_reader;
+  bool m_nonblocking;
+};
+
+} // namespace Libs::LibKernel::FileSystem
+#endif
