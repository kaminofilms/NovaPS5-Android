+
+int FileDescriptors::DupPipe(int oldfd, int newfd) {
+	Common::LockGuard lock(m_mutex);
+	if (oldfd < 0 || newfd < 0) return KERNEL_ERROR_EBADF;
+	std::shared_ptr<GuestPipe> pipe;
+	if (oldfd < 3) {
+		if (m_standard_closed[oldfd]) return KERNEL_ERROR_EBADF;
+		pipe = m_standard_pipes[oldfd];
+	} else {
+		const auto index = static_cast<size_t>(oldfd - 3);
+		if (index >= m_files.size() || m_files[index] == nullptr || !m_files[index]->opened)
+			return KERNEL_ERROR_EBADF;
+		pipe = m_files[index]->pipe;
+	}
+	if (oldfd == newfd) return newfd;
+	// This boot path duplicates pipe endpoints; unsupported sources report an
+	// error rather than returning success without changing the descriptor.
+	if (!pipe) return KERNEL_ERROR_ENOSYS;
+	if (newfd >= 65536) return KERNEL_ERROR_EBADF;
+	if (::Libs::Network::Net::IsSocket(newfd)) return KERNEL_ERROR_ENOSYS;
+	if (newfd < 3) {
+		m_standard_pipes[newfd] = std::move(pipe);
+		m_standard_closed[newfd] = false;
+		m_standard_cloexec[newfd] = false;
+	} else {
+		const auto index = static_cast<size_t>(newfd - 3);
+		if (index >= m_files.size()) m_files.resize(index + 1, nullptr);
+		if (m_files[index] != nullptr) {
+			if (m_files[index]->opened && m_files[index]->special == SpecialFile::None)
+				m_files[index]->f.Close();
+			delete m_files[index];
+		}
+		auto* file = new File {};
+		file->special = SpecialFile::Pipe;
+		file->readable = pipe->Reader();
+		file->writable = !pipe->Reader();
+		file->opened = true;
+		file->pipe = std::move(pipe);
+		m_files[index] = file;
+	}
+	return newfd;
+}
+
+bool FileDescriptors::ClosePipe(int d) {
+	Common::LockGuard lock(m_mutex);
+	if (d < 0) return false;
+	if (d < 3) {
+		if (m_standard_closed[d]) return false;
+		m_standard_pipes[d].reset();
+		m_standard_closed[d] = true;
+		return true;
+	}
+	const auto index = static_cast<size_t>(d - 3);
+	if (index >= m_files.size() || m_files[index] == nullptr || !m_files[index]->pipe) return false;
+	delete m_files[index];
+	m_files[index] = nullptr;
+	return true;
+}
+
+int FileDescriptors::PipeFcntl(int d, int command, int arg) {
+	Common::LockGuard lock(m_mutex);
+	std::shared_ptr<GuestPipe> pipe;
+	bool cloexec = false;
+	File* file = nullptr;
+	if (d >= 0 && d < 3) {
+		pipe = m_standard_pipes[d];
+		cloexec = m_standard_cloexec[d];
+	} else if (d >= 3 && static_cast<size_t>(d - 3) < m_files.size()) {
+		file = m_files[d - 3];
+		if (file != nullptr) {
+			pipe = file->pipe;
+			cloexec = file->close_on_exec;
+		}
+	}
+	if (!pipe) return KERNEL_ERROR_EBADF;
+	switch (command) {
+		case 1: return cloexec;
+		case 2:
+			if (file != nullptr) file->close_on_exec = (arg & 1) != 0;
+			else m_standard_cloexec[d] = (arg & 1) != 0;
+			return OK;
+		case 3: return (pipe->Reader() ? 0 : 1) | (pipe->Nonblocking() ? 4 : 0);
+		case 4: pipe->SetNonblocking((arg & 4) != 0); return OK;
+		default: return KERNEL_ERROR_EINVAL;
+	}
+}
