diff --git a/tests/GuestPipeTests.cpp b/tests/GuestPipeTests.cpp
new file mode 100644
index 0000000..599ba2c
--- /dev/null
+++ b/tests/GuestPipeTests.cpp
@@ -0,0 +1,113 @@
+#include "kernel/guestPipe.h"
+#include "libs/guestStdio.h"
+
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <future>
+#include <string>
+#include <thread>
+#include <vector>
+#include <cstdio>
+
+using Libs::LibKernel::FileSystem::GuestPipe;
+using namespace std::chrono_literals;
+
+namespace {
+int native_calls = 0, guest_calls = 0;
+void* last_native = nullptr;
+void* last_guest = nullptr;
+int NativeFlush(void* p) { ++native_calls; last_native = p; return 0; }
+int GuestFlush(void* p) { ++guest_calls; last_guest = p; return 0; }
+int FailedFlush(void*) { return -1; }
+
+void CheckStdio() {
+  int out = 0, err = 0, opaque_guest = 0;
+  auto no_guest = static_cast<int (*)(void*)>(nullptr);
+  assert(Libs::FlushGuestStream(&err, &out, &err, NativeFlush, GuestFlush) == 0);
+  assert(native_calls == 1 && last_native == &err && guest_calls == 0);
+  assert(Libs::FlushGuestStream(&opaque_guest, &out, &err, NativeFlush, GuestFlush) == 0);
+  assert(guest_calls == 1 && last_guest == &opaque_guest && native_calls == 1);
+  assert(Libs::FlushGuestStream(nullptr, &out, &err, NativeFlush, GuestFlush) == 0);
+  assert(native_calls == 2 && guest_calls == 2 && last_native == nullptr && last_guest == nullptr);
+  assert(Libs::FlushGuestStream(&opaque_guest, &out, &err, NativeFlush, no_guest) == -1);
+  assert(Libs::FlushGuestStream(nullptr, &out, &err, NativeFlush, FailedFlush) == -1);
+}
+
+void CheckPipe() {
+  auto [reader, writer] = GuestPipe::Create(true);
+  char buffer[32] {};
+  assert(reader->Read(buffer, 1) == -35);
+  assert(writer->Read(buffer, 1) == -9 && reader->Write("x", 1) == -9);
+  assert(reader->Read(nullptr, 0) == 0 && writer->Write(nullptr, 0) == 0);
+  assert(writer->Write("hello", 5) == 5);
+  assert(reader->Read(buffer, sizeof(buffer)) == 5 && std::string(buffer, 5) == "hello");
+  std::vector<char> full(GuestPipe::Capacity, 'x');
+  assert(writer->Write(full.data(), full.size()) == static_cast<int64_t>(full.size()));
+  assert(writer->Write("x", 1) == -35);
+  assert(reader->Read(buffer, 1) == 1);
+  assert(writer->Write("ab", 2) == -35); // small writes cannot partially enter a pipe
+  assert(writer->Write("z", 1) == 1);
+  std::vector<char> drained(full.size());
+  assert(reader->Read(drained.data(), drained.size()) == static_cast<int64_t>(drained.size()));
+  assert(drained.back() == 'z'); // wrapped ring
+  auto duplicate = writer;
+  writer.reset();
+  assert(reader->Read(buffer, 1) == -35); // duplicate keeps write end alive
+  assert(duplicate->Write("tail", 4) == 4);
+  duplicate.reset();
+  assert(reader->Read(buffer, sizeof(buffer)) == 4 && std::string(buffer, 4) == "tail");
+  assert(reader->Read(buffer, 1) == 0);
+  auto [closed_reader, orphan_writer] = GuestPipe::Create(false);
+  closed_reader.reset();
+  assert(orphan_writer->Write("x", 1) == -32);
+}
+
+void CheckBlockingAndAtomicity() {
+  auto [reader, writer] = GuestPipe::Create(false);
+  auto pending = std::async(std::launch::async, [&] {
+    char buf[4] {};
+    return reader->Read(buf, 4);
+  });
+  assert(pending.wait_for(30ms) == std::future_status::timeout);
+  assert(writer->Write("test", 4) == 4);
+  assert(pending.wait_for(2s) == std::future_status::ready && pending.get() == 4);
+  auto eof = std::async(std::launch::async, [&] { char c; return reader->Read(&c, 1); });
+  writer.reset();
+  assert(eof.wait_for(2s) == std::future_status::ready && eof.get() == 0);
+
+  auto [r, w] = GuestPipe::Create(false);
+  std::vector<char> all(2 * 256 * GuestPipe::AtomicWrite);
+  auto drain = std::async(std::launch::async, [&] {
+    size_t offset = 0;
+    while (offset < all.size()) {
+      const auto bytes = r->Read(all.data() + offset, all.size() - offset);
+      assert(bytes > 0);
+      offset += static_cast<size_t>(bytes);
+    }
+  });
+  auto produce = [&](char value) {
+    std::vector<char> block(GuestPipe::AtomicWrite, value);
+    for (int i = 0; i < 256; ++i) assert(w->Write(block.data(), block.size()) == static_cast<int64_t>(block.size()));
+  };
+  std::thread a(produce, 'a'), b(produce, 'b');
+  a.join(); b.join();
+  assert(drain.wait_for(5s) == std::future_status::ready); drain.get();
+  for (size_t i = 0; i < all.size(); i += GuestPipe::AtomicWrite)
+    for (size_t j = i; j < i + GuestPipe::AtomicWrite; ++j) assert(all[j] == all[i]);
+
+  auto [nr, nw] = GuestPipe::Create(true);
+  std::vector<char> big(GuestPipe::Capacity + 1, 'q');
+  assert(nw->Write(big.data(), big.size()) == GuestPipe::Capacity);
+  nw->SetNonblocking(false);
+  auto blocked = std::async(std::launch::async, [&] { return nw->Write("x", 1); });
+  assert(blocked.wait_for(30ms) == std::future_status::timeout);
+  nr.reset();
+  assert(blocked.wait_for(2s) == std::future_status::ready && blocked.get() == -32);
+}
+}
+
+int main() {
+  CheckStdio(); CheckPipe(); CheckBlockingAndAtomicity();
+  std::puts("GuestPipeTests: all checks passed");
+}
diff --git a/tests/HomebrewBootApiTests.cpp b/tests/HomebrewBootApiTests.cpp
new file mode 100644
index 0000000..8692042
--- /dev/null
+++ b/tests/HomebrewBootApiTests.cpp
@@ -0,0 +1,86 @@
+#include "common/emulatorConfig.h"
+#include "common/logging/log.h"
+#include "common/subsystems.h"
+#include "common/threads.h"
+#include "kernel/fileSystem.h"
+#include "libs/errno.h"
+#include "loader/symbolDatabase.h"
+
+#include <cassert>
+#include <chrono>
+#include <cstring>
+#include <future>
+#include <cstdio>
+
+namespace Libs {
+void InitLibKernel_1(Loader::SymbolDatabase*);
+namespace LibcInternal { void InitLibcInternal_1(Loader::SymbolDatabase*); }
+}
+
+using namespace std::chrono_literals;
+namespace FS = Libs::LibKernel::FileSystem;
+
+int main() {
+  Common::InitializeThreads();
+  Common::Subsystems subsystems;
+  subsystems.Initialize<Config::Lifecycle>();
+  Config::ConfigOptions options;
+  options.printf_direction = Config::LogDirection::Silent;
+  Config::Load(options);
+  subsystems.Initialize<Log::Lifecycle>();
+  FS::Initialize();
+  Loader::SymbolDatabase symbols;
+  Libs::InitLibKernel_1(&symbols);
+  Libs::LibcInternal::InitLibcInternal_1(&symbols);
+  auto find = [&](const char* nid) {
+    const auto* s = symbols.FindByNid(nid, Loader::SymbolType::Func);
+    assert(s != nullptr);
+    return s->vaddr;
+  };
+  auto pipe = reinterpret_cast<int (KYTY_SYSV_ABI *)(int*)>(find("-Jp7F+pXxNg"));
+  auto dup2 = reinterpret_cast<int (KYTY_SYSV_ABI *)(int, int)>(find("wdUufa9g-D8"));
+  auto close = reinterpret_cast<int (KYTY_SYSV_ABI *)(int)>(find("NNtFaKJbPt0"));
+  auto read = reinterpret_cast<int64_t (KYTY_SYSV_ABI *)(int, void*, uint64_t)>(find("DRuBt2pvICk"));
+  auto write = reinterpret_cast<int64_t (KYTY_SYSV_ABI *)(int, const char*, int64_t)>(find("FxVZqBAA7ks"));
+  auto flush = reinterpret_cast<int (KYTY_SYSV_ABI *)(FILE*)>(find("MUjC4lbHrK4"));
+  auto debug = reinterpret_cast<int (KYTY_SYSV_ABI *)(int, const char*)>(find("9JYNqN6jAKI"));
+  assert(pipe(nullptr) == -1 && *Libs::Posix::GetErrorAddr() == Libs::Posix::POSIX_EFAULT);
+  int ends[2] {-1, -1};
+  assert(pipe(ends) == 0 && ends[0] >= 3 && ends[1] >= 3 && ends[0] != ends[1]);
+  assert(FS::KernelFcntl(ends[1], 2, 1) == OK);
+  assert(dup2(ends[1], 2) == 2 && FS::KernelFcntl(2, 1, 0) == 0);
+  assert(close(ends[1]) == 0);
+  assert(flush(stderr) == 0 && flush(nullptr) == 0);
+  assert(write(2, "ccleste boot log\n", 17) == 17);
+  char buffer[64] {};
+  assert(read(ends[0], buffer, sizeof(buffer)) == 17 && std::strcmp(buffer, "ccleste boot log\n") == 0);
+  // A duplicated descriptor shares its open-file flags, but not FD_CLOEXEC.
+  assert(FS::KernelFcntl(2, 4, 4) == OK);
+  assert(dup2(2, 27) == 27 && (FS::KernelFcntl(27, 3, 0) & 4) != 0);
+  FS::FileStat stat {};
+  assert(FS::KernelFstat(27, &stat) == OK && (stat.st_mode & 0170000) == 0010000);
+  assert(FS::KernelLseek(27, 0, 0) == Libs::LibKernel::KERNEL_ERROR_ESPIPE);
+  assert(FS::KernelPread(27, buffer, 1, 0) == Libs::LibKernel::KERNEL_ERROR_ESPIPE);
+  assert(FS::KernelFtruncate(27, 0) == Libs::LibKernel::KERNEL_ERROR_EINVAL);
+  assert(close(2) == 0 && write(2, "x", 1) == -1);
+  assert(FS::KernelFcntl(ends[0], 4, 4) == OK);
+  assert(read(ends[0], buffer, 1) == -1 && *Libs::Posix::GetErrorAddr() == Libs::Posix::POSIX_EAGAIN);
+  assert(close(27) == 0 && read(ends[0], buffer, 1) == 0);
+  assert(close(ends[0]) == 0 && dup2(ends[0], 2) == -1);
+  assert(pipe(ends) == 0);
+  auto waiting = std::async(std::launch::async, [&] { return FS::KernelRead(ends[0], buffer, sizeof(buffer)); });
+  assert(waiting.wait_for(30ms) == std::future_status::timeout);
+  assert(close(ends[1]) == 0);
+  assert(waiting.wait_for(2s) == std::future_status::ready && waiting.get() == 0);
+  assert(close(ends[0]) == 0);
+  assert(debug(0, "HomebrewBootApiTests: debug output works\n") == OK);
+  assert(debug(0, nullptr) == Libs::LibKernel::KERNEL_ERROR_EFAULT);
+  assert(write(-1, "x", 1) == -1 && *Libs::Posix::GetErrorAddr() == Libs::Posix::POSIX_EBADF);
+  assert(FS::KernelPipe2(ends, 8) == Libs::LibKernel::KERNEL_ERROR_EINVAL);
+  assert(FS::KernelPipe2(ends, 4 | 0x00100000) == OK);
+  assert(FS::KernelFcntl(ends[0], 1, 0) == 1 && (FS::KernelFcntl(ends[1], 3, 0) & 4) != 0);
+  assert(close(ends[0]) == 0 && write(ends[1], "x", 1) == -1 && *Libs::Posix::GetErrorAddr() == Libs::Posix::POSIX_EPIPE);
+  assert(close(ends[1]) == 0);
+  FS::Shutdown();
+  std::puts("HomebrewBootApiTests: all checks passed (no game boot claimed)");
+}
