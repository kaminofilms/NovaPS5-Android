+#ifndef KYTY_LIBS_GUEST_STDIO_H_
+#define KYTY_LIBS_GUEST_STDIO_H_
+
+namespace Libs {
+
+// Never pass an opaque guest FILE to the host CRT. The loaded guest libc owns
+// both the layout and buffering, including its fflush(NULL) stream registry.
+template <typename NativeFlush, typename GuestFlush>
+int FlushGuestStream(void* stream, void* host_stdout, void* host_stderr,
+                     NativeFlush native_flush, GuestFlush guest_flush) {
+  if (stream == host_stdout || stream == host_stderr) return native_flush(stream);
+  if (stream != nullptr) return guest_flush ? guest_flush(stream) : -1;
+  const auto native_result = native_flush(nullptr);
+  const auto guest_result = guest_flush ? guest_flush(nullptr) : 0;
+  return native_result != 0 || guest_result != 0 ? -1 : 0;
+}
+
+} // namespace Libs
+#endif
